---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ClientsCarousel from '../components/ClientsCarousel.astro';
import AboutUs from '../components/AboutUs.astro';
import Services from '../components/Services.astro';
import FrozenLine from '../components/FrozenLine.astro';
import DryCargoLine from '../components/DryCargoLine.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout
	title="Logística Internacional de Carga"
	description="En GTM Alliance movemos tu carga seca y general por mar, tierra y aire con soluciones logísticas confiables, seguras y a tiempo. Solicita tu cotización hoy."
	keywords="logística de carga, freight forwarding, carga seca, importación exportación, agente aduanal"
>
	<Hero />
	<ClientsCarousel />
	<AboutUs />
	<Services />
	<FrozenLine />
	<DryCargoLine />
	<Contact />
</BaseLayout>
