---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_FORM_CONFIG } from '../data/contact-form';

const pageURL = new URL('/pqrsd/', 'https://gtm-alliance.com').href;

const pqrsdSchema = [
	{
		'@type': 'ContactPage',
		'@id': `${pageURL}#webpage`,
		url: pageURL,
		name: 'PQRSD | GTM Alliance',
		description:
			'Formulario de PQRSD de GTM Alliance para peticiones, quejas, reclamos, sugerencias y solicitudes de información.',
		inLanguage: 'es-CO',
		isPartOf: { '@id': 'https://gtm-alliance.com/#website' },
		about: { '@id': 'https://gtm-alliance.com/#organization' },
		breadcrumb: { '@id': `${pageURL}#breadcrumb` },
	},
	{
		'@type': 'BreadcrumbList',
		'@id': `${pageURL}#breadcrumb`,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gtm-alliance.com/' },
			{ '@type': 'ListItem', position: 2, name: 'PQRSD' },
		],
	},
];
---

<BaseLayout
	title="PQRSD"
	description="Formulario de PQRSD de GTM Alliance para peticiones, quejas, reclamos, sugerencias y solicitudes de información."
	schema={pqrsdSchema}
>
	<section id="pqrsd" class="relative overflow-hidden py-20 sm:py-28">
		<div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl">
				<span class="font-display inline-block text-xs font-semibold tracking-[0.35em] text-gtm-gold-ink uppercase">
					PQRSD
				</span>
				<h1 class="font-display mt-4 text-4xl leading-tight font-bold text-gtm-navy sm:text-5xl lg:text-6xl">
					Tu voz importa en cada operación
				</h1>
				<p class="mt-5 text-lg leading-relaxed text-slate-700">
					En GTM Alliance valoramos tus comentarios, solicitudes y reclamos. Completa este formulario
					y nos pondremos en contacto contigo para atender tu caso con la mayor celeridad.
				</p>
			</div>

			<div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
				<div class="rounded-3xl border border-gtm-navy/10 bg-gtm-surface p-8 shadow-2xl shadow-gtm-navy/10 backdrop-blur-sm">
					<h2 class="font-display text-2xl font-semibold text-gtm-navy">¿Qué puedes reportar?</h2>
					<ul class="mt-6 space-y-4 text-sm leading-relaxed text-slate-700">
						<li class="flex gap-3">
							<span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-gtm-gold"></span>
							<span>Petición de información sobre servicios, tiempos o costos.</span>
						</li>
						<li class="flex gap-3">
							<span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-gtm-gold"></span>
							<span>Quejas o reclamos relacionados con una operación o servicio.</span>
						</li>
						<li class="flex gap-3">
							<span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-gtm-gold"></span>
							<span>Sugerencias para mejorar la experiencia de nuestros clientes.</span>
						</li>
					</ul>

					<div class="mt-8 rounded-2xl border border-gtm-gold/30 bg-gtm-gold/10 p-5">
						<p class="text-sm font-semibold text-gtm-gold-ink">Respuesta estimada</p>
						<p class="mt-2 text-sm leading-relaxed text-slate-700">
							Responderemos tu solicitud dentro de los tiempos establecidos por nuestra política de atención al cliente.
						</p>
					</div>
				</div>

				<div class="rounded-3xl border border-gtm-navy/10 bg-gtm-surface p-8 shadow-2xl shadow-gtm-navy/10 backdrop-blur-sm">
					<h2 class="font-display text-2xl font-semibold text-gtm-navy">Formulario de PQRSD</h2>
					<form id="pqrsd-form" class="mt-6 grid gap-5 sm:grid-cols-2" action="https://api.web3forms.com/submit" method="POST">
						<input type="hidden" name="access_key" value={CONTACT_FORM_CONFIG.accessKey} />
						<input type="hidden" name="subject" value={CONTACT_FORM_CONFIG.pqrsd.subject} />
						<input type="hidden" name="from_name" value={CONTACT_FORM_CONFIG.fromName} />
						<input type="hidden" id="numero-radicado" name="numero_radicado" value="" />
						<input
							type="checkbox"
							name="botcheck"
							class="hidden"
							style="display: none;"
							tabindex="-1"
							autocomplete="off"
						/>

						<div class="sm:col-span-2">
							<label for="nombre" class="mb-2 block text-sm font-medium text-slate-700">Nombre completo</label>
							<input
								id="nombre"
								name="name"
								type="text"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
								placeholder="Tu nombre"
							/>
						</div>

						<div>
							<label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email</label>
							<input
								id="email"
								name="email"
								type="email"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
								placeholder="tu@email.com"
							/>
						</div>

						<div>
							<label for="telefono" class="mb-2 block text-sm font-medium text-slate-700">Teléfono</label>
							<input
								id="telefono"
								name="telefono"
								type="tel"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
								placeholder="+57 300 000 0000"
							/>
						</div>

						<div class="sm:col-span-2">
							<label for="tipo" class="mb-2 block text-sm font-medium text-slate-700">Tipo de solicitud</label>
							<select
								id="tipo"
								name="tipo"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
							>
								<option value="" disabled selected>Selecciona una opción</option>
								<option value="peticion">Petición</option>
								<option value="queja">Queja</option>
								<option value="reclamo">Reclamo</option>
								<option value="sugerencia">Sugerencia</option>
								<option value="solicitud-informacion">Solicitud de información</option>
								<option value="incidencia-operativa">Incidencia operativa</option>
								<option value="otro">Otro</option>
							</select>
						</div>

						<div class="sm:col-span-2">
							<label for="mensaje" class="mb-2 block text-sm font-medium text-slate-700">Mensaje</label>
							<textarea
								id="mensaje"
								name="message"
								rows="4"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
								placeholder="Describe los detalles de tu solicitud"
							></textarea>
						</div>

						<div class="sm:col-span-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
							<button
								id="pqrsd-submit"
								type="submit"
								class="inline-flex items-center justify-center rounded-full bg-gtm-gold px-7 py-3 text-sm font-semibold text-gtm-navy transition-transform hover:scale-[1.02] disabled:cursor-not-allowed disabled:opacity-60"
							>
								Enviar solicitud
							</button>
							<p id="pqrsd-form-status" class="text-sm text-slate-500" role="status" aria-live="polite">
								Tu información está segura con nosotros.
							</p>
						</div>

						<div
							id="pqrsd-success"
							class="hidden sm:col-span-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4"
							role="status"
							aria-live="polite"
						>
							<p class="text-sm font-semibold text-emerald-900">Solicitud recibida correctamente</p>
							<p class="mt-2 text-sm leading-relaxed text-emerald-800">
								Guarda tu número de radicado para dar seguimiento a tu caso:
							</p>
							<p id="pqrsd-radicado-display" class="font-display mt-2 text-lg font-bold tracking-wide text-gtm-navy"></p>
						</div>
					</form>
				</div>
			</div>
		</div>
	</section>

	<div id="privacy-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-gtm-navy/40 px-4 backdrop-blur-sm">
		<div class="w-full max-w-lg rounded-3xl border border-gtm-navy/10 bg-gtm-surface p-8 shadow-2xl shadow-gtm-navy/15">
			<h3 class="font-display text-2xl font-semibold text-gtm-navy">Política de tratamiento de datos</h3>
			<p class="mt-4 text-sm leading-relaxed text-slate-700">
				Tus datos serán utilizados únicamente para identificarte, atender tu solicitud y dar seguimiento a tu caso. Puedes solicitar la actualización o eliminación de tus datos en cualquier momento.
			</p>
			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
				<button id="cancel-policy" type="button" class="rounded-full border border-gtm-navy/20 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-gtm-navy/5">
					Cancelar
				</button>
				<button id="accept-policy" type="button" class="rounded-full bg-gtm-gold px-5 py-2.5 text-sm font-semibold text-gtm-navy transition-transform hover:scale-[1.02]">
					Aceptar
				</button>
			</div>
		</div>
	</div>

	<style>
		select#tipo option {
			background-color: #ffffff;
			color: #1c2f4a;
		}

		select#tipo option[disabled] {
			color: #64748b;
		}
	</style>

	<script>
		import { CONTACT_FORM_CONFIG, generateNumeroRadicado } from '../data/contact-form';

		const form = document.getElementById('pqrsd-form') as HTMLFormElement | null;
		const modal = document.getElementById('privacy-modal');
		const cancelButton = document.getElementById('cancel-policy');
		const acceptButton = document.getElementById('accept-policy');
		const submitButton = document.getElementById('pqrsd-submit') as HTMLButtonElement | null;
		const statusEl = document.getElementById('pqrsd-form-status');
		const successEl = document.getElementById('pqrsd-success');
		const radicadoInput = document.getElementById('numero-radicado') as HTMLInputElement | null;
		const radicadoDisplay = document.getElementById('pqrsd-radicado-display');
		const accessKey = CONTACT_FORM_CONFIG.accessKey.trim();

		function setStatus(message: string, tone: 'default' | 'error' | 'success') {
			if (!statusEl) return;

			statusEl.textContent = message;
			statusEl.classList.remove('text-red-600', 'text-emerald-700', 'text-slate-500');

			if (tone === 'error') {
				statusEl.classList.add('text-red-600');
			} else if (tone === 'success') {
				statusEl.classList.add('text-emerald-700');
			} else {
				statusEl.classList.add('text-slate-500');
			}
		}

		function hideSuccess() {
			successEl?.classList.add('hidden');
			if (radicadoDisplay) radicadoDisplay.textContent = '';
			if (radicadoInput) radicadoInput.value = '';
		}

		function showSuccess(radicado: string) {
			if (radicadoDisplay) radicadoDisplay.textContent = radicado;
			successEl?.classList.remove('hidden');
		}

		async function submitForm(formElement: HTMLFormElement) {
			if (submitButton) {
				submitButton.disabled = true;
				submitButton.textContent = 'Enviando...';
			}

			hideSuccess();
			setStatus('Enviando...', 'default');

			const radicado = generateNumeroRadicado();
			if (radicadoInput) radicadoInput.value = radicado;

			try {
				const formData = new FormData(formElement);
				const payload = Object.fromEntries(formData.entries());

				payload.subject = `${CONTACT_FORM_CONFIG.pqrsd.subject} [${radicado}]`;

				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						Accept: 'application/json',
					},
					body: JSON.stringify(payload),
				});

				const result = await response.json().catch(() => ({
					success: false,
					message: 'Respuesta inesperada del servicio.',
				}));

				if (response.ok && result.success) {
					formElement.reset();
					if (radicadoInput) radicadoInput.value = radicado;
					showSuccess(radicado);
					setStatus('¡Solicitud enviada! Guarda tu número de radicado.', 'success');
				} else {
					throw new Error(result.message ?? 'No se pudo enviar la solicitud.');
				}
			} catch (error) {
				const message = error instanceof Error ? error.message : 'No se pudo enviar la solicitud.';
				console.error('Web3Forms PQRSD submit failed', error);
				setStatus(`No pudimos enviar tu solicitud. ${message}`, 'error');
			} finally {
				if (submitButton) {
					submitButton.disabled = false;
					submitButton.textContent = 'Enviar solicitud';
				}
			}
		}

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			modal?.classList.remove('hidden');
			modal?.classList.add('flex');
		});

		cancelButton?.addEventListener('click', () => {
			modal?.classList.add('hidden');
			modal?.classList.remove('flex');
		});

		acceptButton?.addEventListener('click', async () => {
			modal?.classList.add('hidden');
			modal?.classList.remove('flex');

			if (!form) return;

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			if (!accessKey) {
				setStatus('Falta la clave de Web3Forms. Configúrala en src/data/contact-form.ts.', 'error');
				return;
			}

			await submitForm(form);
		});

		form?.addEventListener('input', () => {
			hideSuccess();
			setStatus('Tu información está segura con nosotros.', 'default');
		});
	</script>
</BaseLayout>
