---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DotGrid from '../components/DotGrid.astro';
import Globe from '../components/Globe.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { TELEFONO, CORREOS, SEDE_PRINCIPAL } from '../data/contact';
import { LOCALE_META } from '../i18n/config';
import { getLocale, useTranslations, alternateURLs } from '../i18n/utils';
import logoImg from '../assets/logo.webp';
import transporteInternacionalImg from '../assets/servicios/transporte-internacional.webp';
import agenciamientoAduaneroImg from '../assets/servicios/agenciamiento-aduanero.webp';
import almacenajeDistribucionImg from '../assets/servicios/almacenaje-distribucion.webp';
import consolidacionCargaImg from '../assets/servicios/consolidacion-carga.webp';
import seguroMercanciasImg from '../assets/servicios/seguro-mercancias.webp';
import asesoriaComercioExteriorImg from '../assets/servicios/asesoria-comercio-exterior.webp';
import lineaCongeladosImg from '../assets/linea-congelados.jpg';
import lineaCargaSecaImg from '../assets/linea-carga-seca.jpg';

interface Props {
	title: string;
	description: string;
	image?: string | ImageMetadata;
	canonicalURL?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, type = 'website', noindex = false, schema } = Astro.props;

const lang = getLocale(Astro.url);
const t = useTranslations(lang);
const localeMeta = LOCALE_META[lang];

const siteBase = Astro.site ?? new URL('https://gtm-alliance.com');
const canonicalURL = Astro.props.canonicalURL ?? new URL(Astro.url.pathname, siteBase).href;
const alternates = alternateURLs(Astro.url.pathname, siteBase);

let ogImageURL: string;
let ogImageWidth: number;
let ogImageHeight: number;

if (typeof image === 'string') {
	ogImageURL = new URL(image, siteBase).href;
	ogImageWidth = 1200;
	ogImageHeight = 630;
} else {
	const sourceImage = image ?? logoImg;
	const ogAsset = await getImage({
		src: sourceImage,
		width: sourceImage.width,
		height: sourceImage.height,
		background: '#ffffff',
		format: 'png',
	});
	ogImageURL = new URL(ogAsset.src, siteBase).href;
	ogImageWidth = ogAsset.attributes.width ?? sourceImage.width;
	ogImageHeight = ogAsset.attributes.height ?? sourceImage.height;
}
const fullTitle = `${title} | GTM Alliance`;

const organizationId = `${siteBase.href}#organization`;
const websiteId = `${siteBase.href}#website`;
const logoId = `${siteBase.href}#logo`;

const servicios: {
	slug: string;
	name: string;
	description: string;
	image: ImageMetadata;
	anchor?: string;
}[] = [
	{
		slug: 'transporte-internacional',
		...t.schema.servicios.transporteInternacional,
		image: transporteInternacionalImg,
	},
	{
		slug: 'agenciamiento-aduanero',
		...t.schema.servicios.agenciamientoAduanero,
		image: agenciamientoAduaneroImg,
	},
	{
		slug: 'almacenaje-distribucion',
		...t.schema.servicios.almacenajeDistribucion,
		image: almacenajeDistribucionImg,
	},
	{
		slug: 'consolidacion-carga',
		...t.schema.servicios.consolidacionCarga,
		image: consolidacionCargaImg,
	},
	{
		slug: 'seguro-mercancias',
		...t.schema.servicios.seguroMercancias,
		image: seguroMercanciasImg,
	},
	{
		slug: 'asesoria-comercio-exterior',
		...t.schema.servicios.asesoriaComercioExterior,
		image: asesoriaComercioExteriorImg,
	},
	{
		slug: 'linea-congelados',
		...t.schema.servicios.lineaCongelados,
		image: lineaCongeladosImg,
		anchor: '#congelados',
	},
	{
		slug: 'linea-carga-seca',
		...t.schema.servicios.lineaCargaSeca,
		image: lineaCargaSecaImg,
		anchor: '#carga-seca',
	},
];

const serviceImages = await Promise.all(
	servicios.map((servicio) =>
		getImage({ src: servicio.image, format: 'webp', width: Math.min(1200, servicio.image.width), quality: 80 }),
	),
);

const serviceNodes = servicios.map((servicio, i) => ({
	'@type': 'Service',
	'@id': `${siteBase.href}#servicio-${servicio.slug}`,
	name: servicio.name,
	serviceType: servicio.name,
	description: servicio.description,
	provider: { '@id': organizationId },
	areaServed: { '@type': 'Country', name: 'Colombia' },
	url: `${alternates[lang]}${servicio.anchor ?? '#servicios'}`,
	image: {
		'@type': 'ImageObject',
		url: new URL(serviceImages[i].src, siteBase).href,
		width: serviceImages[i].attributes.width,
		height: serviceImages[i].attributes.height,
	},
	inLanguage: localeMeta.schemaLanguage,
}));

const organizationNode = {
	'@type': ['Organization', 'LocalBusiness'],
	'@id': organizationId,
	name: 'GTM Alliance',
	legalName: 'GTM Alliance S.A.S.',
	description: t.schema.organizationDescription,
	url: siteBase.href,
	logo: {
		'@type': 'ImageObject',
		'@id': logoId,
		url: new URL(logoImg.src, siteBase).href,
		width: logoImg.width,
		height: logoImg.height,
		caption: 'GTM Alliance',
	},
	image: { '@id': logoId },
	telephone: TELEFONO.tel.replace('tel:', ''),
	email: CORREOS.gerencia,
	identifier: {
		'@type': 'PropertyValue',
		name: 'NIT',
		value: '902028580',
	},
	naics: '488510',
	isicV4: '5229',
	knowsLanguage: ['es', 'en'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: SEDE_PRINCIPAL.streetAddress,
		addressLocality: SEDE_PRINCIPAL.addressLocality,
		addressRegion: SEDE_PRINCIPAL.addressRegion,
		addressCountry: SEDE_PRINCIPAL.addressCountry,
	},
	areaServed: { '@type': 'Country', name: 'Colombia' },
	sameAs: ['https://www.linkedin.com/company/gtm-alliance'],
	contactPoint: [
		{
			'@type': 'ContactPoint',
			contactType: 'customer service',
			telephone: TELEFONO.tel.replace('tel:', ''),
			email: CORREOS.gerencia,
			areaServed: 'CO',
			availableLanguage: [
				{ '@type': 'Language', name: 'Spanish', alternateName: 'es' },
				{ '@type': 'Language', name: 'English', alternateName: 'en' },
			],
		},
		{
			'@type': 'ContactPoint',
			contactType: 'billing support',
			telephone: TELEFONO.tel.replace('tel:', ''),
			email: CORREOS.administracion,
			areaServed: 'CO',
			availableLanguage: [
				{ '@type': 'Language', name: 'Spanish', alternateName: 'es' },
				{ '@type': 'Language', name: 'English', alternateName: 'en' },
			],
		},
	],
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: t.schema.offerCatalogName,
		itemListElement: servicios.map((servicio) => ({
			'@type': 'Offer',
			itemOffered: { '@id': `${siteBase.href}#servicio-${servicio.slug}` },
		})),
	},
};

const websiteNode = {
	'@type': 'WebSite',
	'@id': websiteId,
	url: siteBase.href,
	name: 'GTM Alliance',
	inLanguage: localeMeta.schemaLanguage,
	publisher: { '@id': organizationId },
};

const pageSchemaNodes = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const graphSchema = {
	'@context': 'https://schema.org',
	'@graph': [organizationNode, websiteNode, ...serviceNodes, ...pageSchemaNodes],
};
---

<!doctype html>
<html lang={localeMeta.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<meta name="theme-color" content="#faf8f3" />

		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
				new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-MMMHLX5X');</script>

		<link rel="icon" href="/favicon.ico?v=2" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=2" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=2" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-icon-192x192.png?v=2" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
		<link rel="manifest" href="/site.webmanifest" />

		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/PlusJakartaSans-Variable.woff2"
			crossorigin
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/Zodiak-Variable.woff2"
			crossorigin
		/>

		<script>
			import '../scripts/gsap';
		</script>

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalURL} />

		{
			!noindex && (
				<>
					<link rel="alternate" hreflang="es" href={alternates.es} />
					<link rel="alternate" hreflang="en" href={alternates.en} />
					<link rel="alternate" hreflang="x-default" href={alternates.es} />
				</>
			)
		}

		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta property="og:site_name" content="GTM Alliance" />
		<meta property="og:locale" content={localeMeta.ogLocale} />
		<meta property="og:locale:alternate" content={LOCALE_META[lang === 'es' ? 'en' : 'es'].ogLocale} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
	</head>

	<body class="bg-gtm-bone text-slate-700 antialiased">

		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MMMHLX5X"
						  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

		<DotGrid />
		<Globe />
		<Navbar />

		<main class="relative z-10">
			<slot />
		</main>

		<Footer />
	</body>
</html>
