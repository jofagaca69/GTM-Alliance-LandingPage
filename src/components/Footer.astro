---
import { Image } from 'astro:assets';
import { NAV_ITEMS } from '../data/nav';
import { TELEFONO, CORREOS, SEDE_PRINCIPAL } from '../data/contact';
import logo from '../assets/logo.webp';

const year = new Date().getFullYear();
const initialActive = Astro.url.pathname === '/' ? 'inicio' : 'pqrsd';

/* -------------------------------------------------------------------------
 * Contenido del footer.
 *
 * Teléfono y correos vienen de `src/data/contact.ts`. Las entradas marcadas
 * con `placeholder: true` (horarios, redes sociales, páginas legales) siguen
 * pendientes de que el cliente entregue la información definitiva.
 * `grep "placeholder: true"` las lista todas.
 * ---------------------------------------------------------------------- */

type FooterValue = { label: string; href?: string; placeholder?: true };

const lineasContacto: { titulo: string; valores: FooterValue[] }[] = [
	{
		titulo: 'Gerencia',
		valores: [
			{ label: TELEFONO.label, href: TELEFONO.href },
			{ label: CORREOS.gerencia, href: `mailto:${CORREOS.gerencia}` },
		],
	},
	{
		titulo: 'Administración',
		valores: [
			{ label: TELEFONO.label, href: TELEFONO.href },
			{ label: CORREOS.administracion, href: `mailto:${CORREOS.administracion}` },
		],
	},
];

const oficinas: { ciudad: string; direccion: string; placeholder?: true }[] = [
	{ ciudad: SEDE_PRINCIPAL.ciudad, direccion: SEDE_PRINCIPAL.direccion },
	{ ciudad: 'Medellín, Colombia', direccion: 'Próximamente', placeholder: true },
];

const horarios: { dias: string; horas: string; placeholder?: true }[] = [
	{ dias: 'Lunes a viernes', horas: '8:00 a. m. – 6:00 p. m.', placeholder: true },
	{ dias: 'Sábados', horas: '8:00 a. m. – 12:00 m.', placeholder: true },
	{ dias: 'Domingos y festivos', horas: 'Cerrado', placeholder: true },
];

/* Glifos de marca (Simple Icons, viewBox 24x24, `fill="currentColor"`). */
const redes: { nombre: string; href: string; icon: string; placeholder?: true }[] = [
	{
		nombre: 'LinkedIn',
		href: '#',
		placeholder: true,
		icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
	},
	{
		nombre: 'Instagram',
		href: '#',
		placeholder: true,
		icon: '<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>',
	},
	{
		nombre: 'Facebook',
		href: '#',
		placeholder: true,
		icon: '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>',
	},
	{
		nombre: 'YouTube',
		href: '#',
		placeholder: true,
		icon: '<path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>',
	},
];

const legales: FooterValue[] = [
	{ label: 'Formulario PQRSD', href: '/pqrsd/' },
	{ label: 'Política de tratamiento de datos', href: '/pqrsd/', placeholder: true },
	{ label: 'Términos y condiciones', href: '/pqrsd/', placeholder: true },
];

/* Enlace de navegación del footer: punto dorado a la izquierda que aparece
   cuando el scrollspy marca la sección. `data-[active]:hover:` es necesario
   para ganarle a `hover:text-gtm-navy` sin depender del orden de variantes. */
const navLinkClass =
	'relative block pl-3 text-sm text-slate-500 transition-colors before:absolute before:top-1/2 before:left-0 before:h-1.5 before:w-1.5 before:-translate-y-1/2 before:rounded-full before:bg-gtm-gold before:opacity-0 before:transition-opacity hover:text-gtm-navy data-[active]:text-gtm-gold-ink data-[active]:before:opacity-100 data-[active]:hover:text-gtm-gold-ink';
---

<footer class="relative z-10 border-t border-gtm-navy/10 bg-gtm-bone text-slate-600 backdrop-blur-sm">
	<div class="mx-auto max-w-6xl px-4 pt-16 pb-8 sm:px-6 lg:px-8">
		<!-- Banda de marca -->
		<div
			class="flex flex-col gap-6 border-b border-gtm-navy/10 pb-10 sm:flex-row sm:items-center sm:justify-between sm:gap-10"
		>
			<a href="/#inicio" class="inline-flex items-center self-start rounded-2xl px-4 py-3">
				<Image
					src={logo}
					alt="GTM Alliance - Global Team Work"
					width={320}
					class="h-20 w-auto"
					loading="lazy"
				/>
			</a>
			<p class="max-w-md text-sm leading-relaxed text-slate-500">
				Conectamos tu carga con el mundo. Soluciones integrales en comercio exterior y logística
				internacional: carga seca, congelados y mercancías especiales por mar, tierra y aire.
			</p>
		</div>

		<!-- 4 columnas -->
		<div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			<!-- 1. Líneas de contacto -->
			<div class="flex flex-col gap-5">
				<h3 class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
					Líneas de contacto
				</h3>
				{
					lineasContacto.map((linea) => (
						<div class="flex flex-col gap-1">
							<p class="text-sm font-semibold text-gtm-navy">{linea.titulo}</p>
							{linea.valores.map((valor) => {
								const Tag = valor.href ? 'a' : 'span';
								return (
									<Tag
										href={valor.href}
										class="block text-sm break-words text-slate-500 transition-colors hover:text-gtm-navy"
									>
										{valor.label}
									</Tag>
								);
							})}
						</div>
					))
				}
			</div>

			<!-- 2. Navegación (participa en el scrollspy) -->
			<div class="flex flex-col gap-5">
				<h3 class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
					Navegación
				</h3>
				<ul class="flex flex-col gap-2.5">
					{
						NAV_ITEMS.map((item) =>
							item.kind === 'link' ? (
								<li>
									<a
										href={item.href}
										data-nav-link={item.id}
										data-active={item.id === initialActive ? '' : undefined}
										aria-current={item.id === initialActive ? 'page' : undefined}
										class={navLinkClass}
									>
										{item.label}
									</a>
								</li>
							) : (
								<li class="mt-1 flex flex-col gap-2">
									<span class="font-display text-[10px] font-semibold tracking-widest text-gtm-gold-ink uppercase">
										{item.label}
									</span>
									<ul class="flex flex-col gap-2 pl-3">
										{item.children.map((sub) => (
											<li>
												<a href={sub.href} data-nav-link={sub.id} class={navLinkClass}>
													{sub.label}
												</a>
											</li>
										))}
									</ul>
								</li>
							),
						)
					}
				</ul>
			</div>

			<!-- 3. Oficinas de Atención -->
			<div class="flex flex-col gap-5">
				<h3 class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
					Oficinas de Atención
				</h3>
				{
					oficinas.map((oficina) => (
						<div class="flex flex-col gap-1">
							<p class="text-sm font-semibold text-gtm-navy">{oficina.ciudad}</p>
							<p class="text-sm leading-relaxed text-slate-500">{oficina.direccion}</p>
						</div>
					))
				}

				<div class="flex flex-col gap-2">
					<p class="text-sm font-semibold text-gtm-navy">Horarios de atención</p>
					<dl class="flex flex-col gap-1">
						{
							horarios.map((horario) => (
								<div class="flex flex-wrap justify-between gap-x-3">
									<dt class="text-sm text-slate-500">{horario.dias}</dt>
									<dd class="text-sm text-slate-500">{horario.horas}</dd>
								</div>
							))
						}
					</dl>
				</div>


			</div>

			<!-- 4. Redes sociales + General -->
			<div class="flex flex-col gap-5">
				<h3 class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
					Síguenos
				</h3>
				<ul class="flex flex-wrap gap-3">
					{
						redes.map((red) => (
							<li>
								<a
									href={red.href}
									aria-label={red.nombre}
									rel="noopener noreferrer"
									class="flex h-10 w-10 items-center justify-center rounded-full bg-gtm-navy/5 text-slate-600 ring-1 ring-gtm-navy/10 transition-colors hover:bg-gtm-gold hover:text-gtm-navy"
								>
									<span
										set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">${red.icon}</svg>`}
									/>
								</a>
							</li>
						))
					}
				</ul>

				<h3 class="font-display mt-2 text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
					General
				</h3>
				<ul class="flex flex-col gap-2.5">
					{
						legales.map((item) => (
							<li>
								<a href={item.href} class="text-sm text-slate-500 transition-colors hover:text-gtm-navy">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<!-- Divider + copyright -->
		<div
			class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gtm-navy/10 pt-8 sm:flex-row"
		>
			<p class="text-xs text-slate-500">
				&copy; {year} GTM Alliance. Todos los derechos reservados.
			</p>
			<a
				href="/#contacto"
				class="rounded-full bg-gtm-gold px-6 py-2.5 text-xs font-semibold text-gtm-navy transition-transform hover:scale-105"
			>
				Solicita una cotización
			</a>
		</div>
	</div>
</footer>
