				</div>


			</div>

			<!-- 4. General (derecha) -->
			<div class="flex flex-col gap-5 sm:col-span-2 lg:col-span-3 lg:col-start-10">
				<h3 class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
					General
				</h3>
				<ul class="flex flex-col gap-2.5">
					{
						legales.map((item) => {
							const external = item.href?.startsWith('http');
							return (
								<li>
									<a
										href={item.href}
										class="text-sm leading-snug text-slate-500 transition-colors hover:text-gtm-navy"
										{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
									>
										{item.label}
									</a>
								</li>
							);
						})
					}
				</ul>
			</div>
		</div>

		<!-- Divider + copyright -->
		<div
			class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gtm-navy/10 pt-8 sm:flex-row"
		>
			<p class="text-xs text-slate-500">
				&copy; {year} GTM Alliance. Todos los derechos reservados.
			</p>
			<a
				href={TELEFONO2.whatsapp}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-full bg-gtm-gold px-6 py-2.5 text-xs font-semibold text-gtm-navy transition-transform hover:scale-105"
			>
				Solicita una cotización
			</a>
		</div>
	</div>
</footer>
