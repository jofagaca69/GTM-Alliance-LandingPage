---
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-white/10 bg-gtm-deep/70 text-slate-300 backdrop-blur-sm">
	<div class="mx-auto max-w-4xl px-4 pt-16 pb-8 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
			<!-- Marca -->
			<div class="flex flex-col gap-4">
				<a href="#inicio" class="inline-flex items-center self-start rounded-2xl bg-white px-4 py-3">
					<img src="/logo.webp" alt="GTM Alliance - Global Team Work" class="h-24 w-auto" />
				</a>
				<p class="max-w-xs text-sm leading-relaxed text-slate-400">
					Conectamos tu carga con el mundo. Soluciones logísticas de carga seca y general por mar,
					tierra y aire.
				</p>
			</div>

			<!-- Navegación -->
			<div class="flex flex-col gap-4">
				<h3 class="font-display text-xs font-semibold tracking-widest text-gtm-gold uppercase">Navegación</h3>
				<ul class="flex flex-col gap-2.5">
					<li>
						<a href="#inicio" class="text-sm text-slate-400 transition-colors hover:text-white">
							Inicio
						</a>
					</li>
					<li>
						<a
							href="#quienes-somos"
							class="text-sm text-slate-400 transition-colors hover:text-white"
						>
							Quiénes Somos
						</a>
					</li>
					<li>
						<a href="#servicios" class="text-sm text-slate-400 transition-colors hover:text-white">
							Servicios
						</a>
					</li>
					<li class="mt-1 flex flex-col gap-2">
						<span class="font-display text-[10px] font-semibold tracking-widest text-gtm-gold uppercase">
							Líneas de Negocio
						</span>
						<ul class="flex flex-col gap-2 pl-3">
							<li>
								<a
									href="#congelados"
									class="text-sm text-slate-400 transition-colors hover:text-white"
								>
									— Congelados
								</a>
							</li>
							<li>
								<a
									href="#carga-seca"
									class="text-sm text-slate-400 transition-colors hover:text-white"
								>
									— Carga Seca
								</a>
							</li>
						</ul>
					</li>
					<li>
						<a href="#contacto" class="text-sm text-slate-400 transition-colors hover:text-white">
							Contacto
						</a>
					</li>
				</ul>
			</div>

			<!-- Contacto -->
			<div class="flex flex-col gap-4">
				<h3 class="font-display text-xs font-semibold tracking-widest text-gtm-gold uppercase">Contacto</h3>
				<ul class="flex flex-col gap-3">
					<li class="flex items-start gap-3">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="mt-0.5 h-4 w-4 shrink-0 text-gtm-gold"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
							></path>
						</svg>
						<a
							href="mailto:info@gtmalliance.com"
							class="text-sm text-slate-400 transition-colors hover:text-white"
						>
							info@gtmalliance.com
						</a>
					</li>
					<li class="flex items-start gap-3">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="mt-0.5 h-4 w-4 shrink-0 text-gtm-gold"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
							></path>
						</svg>
						<a
							href="tel:+573100000000"
							class="text-sm text-slate-400 transition-colors hover:text-white"
						>
							+57 310 000 0000
						</a>
					</li>
					<li class="flex items-start gap-3">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="mt-0.5 h-4 w-4 shrink-0 text-gtm-gold"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
							></path>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
						<span class="text-sm text-slate-400">Bogotá, Colombia</span>
					</li>
				</ul>
			</div>
		</div>

		<!-- Divider + copyright -->
		<div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
			<p class="text-xs text-slate-400">
				&copy; {year} GTM Alliance. Todos los derechos reservados.
			</p>
			<a
				href="#contacto"
				class="rounded-full bg-gtm-gold px-6 py-2.5 text-xs font-semibold text-gtm-navy transition-transform hover:scale-105"
			>
				Solicita una cotización
			</a>
		</div>
	</div>
</footer>
