<div id="globe-layer" class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
	<canvas
		id="globe-canvas"
		class="block h-full w-full opacity-0 blur-[1.5px] transition-opacity duration-700 md:blur-[2.5px]"
	></canvas>

	<!-- Viñeta: mantiene el texto legible cerca de los bordes -->
	<div
		class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_center,rgba(10,18,32,0.30)_0%,rgba(10,18,32,0.48)_65%,rgba(10,18,32,0.80)_100%)]"
	>
	</div>
</div>

<script>
	import { initGlobe } from '../scripts/globe';

	initGlobe();
</script>
