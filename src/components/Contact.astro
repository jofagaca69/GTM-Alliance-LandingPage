---
const contactos = [
	{
		label: 'Sede',
		value: 'Bogotá, Colombia',
		href: undefined,
		icon: '<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>',
	},
	{
		label: 'Correo',
		value: 'info@gtmalliance.com',
		href: 'mailto:info@gtmalliance.com',
		icon: '<path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
	},
	{
		label: 'Teléfono',
		value: '+57 310 000 0000',
		href: 'tel:+573100000000',
		icon: '<path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>',
	},
];
---

<section id="contacto" class="bg-transparent py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<span
			class="contacto-eyebrow font-display inline-block text-xs font-semibold tracking-widest text-gtm-gold uppercase"
		>
			Contacto
		</span>
		<h2
			class="contacto-title font-display mt-3 max-w-3xl text-3xl leading-tight font-bold text-white sm:text-4xl lg:text-5xl"
		>
			Conversemos sobre tus necesidades logísticas
		</h2>
		<p class="contacto-intro mt-4 max-w-3xl text-base leading-relaxed text-slate-300 lg:text-lg">
			Estamos listos para acompañarte en tus proyectos de comercio exterior y exportación.
		</p>

		<div class="mt-10 grid grid-cols-1 gap-6 sm:mt-16 sm:grid-cols-3">
			{
				contactos.map((item) => {
					const Tag = item.href ? 'a' : 'div';
					return (
						<Tag
							href={item.href}
							class="contacto-card group flex flex-col gap-4 rounded-2xl bg-white/5 p-8 ring-1 ring-white/10 backdrop-blur-sm transition-colors hover:bg-white/10"
						>
							<span
								set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">${item.icon}</svg>`}
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-gtm-gold ring-1 ring-white/20"
							/>
							<div>
								<span class="font-display text-xs font-semibold tracking-widest text-gtm-gold uppercase">
									{item.label}
								</span>
								<p class="mt-2 text-base font-semibold text-white transition-colors group-hover:text-gtm-gold">
									{item.value}
								</p>
							</div>
						</Tag>
					);
				})
			}
		</div>

		<div class="contacto-cta mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-start">
			<a
				href="https://wa.me/573100000000"
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105"
			>
				Escribir por WhatsApp
			</a>
			<a
				href="mailto:info@gtmalliance.com"
				class="rounded-full border border-white/40 px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
			>
				Enviar correo
			</a>
		</div>

		<!-- Cuando haya un endpoint de formulario (Formspree, Web3Forms, etc.) va aquí,
		     reemplazando o acompañando los CTAs de arriba. -->
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#contacto');

	if (section) {
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo('.contacto-eyebrow', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5 })
				.fromTo(
					'.contacto-title',
					{ opacity: 0, y: 24 },
					{ opacity: 1, y: 0, duration: 0.7 },
					'-=0.3',
				)
				.fromTo(
					'.contacto-intro',
					{ opacity: 0, y: 24 },
					{ opacity: 1, y: 0, duration: 0.7 },
					'-=0.5',
				)
				.fromTo(
					'.contacto-card',
					{ opacity: 0, y: 32 },
					{ opacity: 1, y: 0, duration: 0.6, stagger: 0.15 },
					'-=0.3',
				)
				.fromTo(
					'.contacto-cta',
					{ opacity: 0, y: 20 },
					{ opacity: 1, y: 0, duration: 0.6 },
					'-=0.2',
				);

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(
				['.contacto-eyebrow', '.contacto-title', '.contacto-intro', '.contacto-card', '.contacto-cta'],
				{ opacity: 1, y: 0 },
			);
		});
	}
</script>
