---
import { TELEFONO, CORREOS, SEDE_PRINCIPAL, whatsappHref } from '../data/contact';
import { CONTACT_FORM_CONFIG } from '../data/contact-form';
import { getLocale, useTranslations } from '../i18n/utils';
import { TELEFONO2 } from '../data/contact';
const lang = getLocale(Astro.url);
const t = useTranslations(lang);

const iconoUbicacion =
	'<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>';
const iconoCorreo =
	'<path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>';
const iconoTelefono =
	'<path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>';

const contactos = [
	{
		label: t.contact.cards.sede.label,
		value: `${SEDE_PRINCIPAL.direccion}, ${SEDE_PRINCIPAL.ciudad}`,
		href: undefined,
		icon: iconoUbicacion,
	},
	{
		label: t.contact.cards.telefono.label,
		value: TELEFONO2.label,
		href: whatsappHref(TELEFONO2.numero, lang),
		icon: iconoTelefono,
	},
	{
		label: t.contact.cards.administracion.label,
		value: CORREOS.administracion,
		href: `mailto:${CORREOS.administracion}`,
		icon: iconoCorreo,
	}
];
---

<section id="contacto" class="bg-transparent py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<span
			class="contacto-eyebrow font-display inline-block text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase"
		>
			{t.contact.eyebrow}
		</span>
		<h2
			class="contacto-title font-display mt-3 max-w-3xl text-3xl leading-tight font-bold text-gtm-navy sm:text-4xl lg:text-5xl"
		>
			{t.contact.title}
		</h2>
		<p class="contacto-intro mt-4 max-w-3xl text-base leading-relaxed text-slate-700 lg:text-lg">
			{t.contact.intro}
		</p>

		<div class="mt-10 grid grid-cols-1 gap-6 sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
			{
				contactos.map((item) => {
					const Tag = item.href ? 'a' : 'div';
					return (
						<Tag
							href={item.href}
							class="contacto-card group flex flex-col gap-4 rounded-2xl bg-gtm-surface p-8 ring-1 ring-gtm-navy/10 backdrop-blur-sm transition-colors hover:bg-gtm-navy/5"
						>
							<span
								set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">${item.icon}</svg>`}
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gtm-navy/5 text-gtm-gold-ink ring-1 ring-gtm-navy/20"
							/>
							<div>
								<span class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
									{item.label}
								</span>
								<p class="mt-2 text-base font-semibold text-gtm-navy transition-colors group-hover:text-gtm-gold-ink">
									{item.value}
								</p>
							</div>
						</Tag>
					);
				})
			}
		</div>

		<div class="contacto-cta mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-start">
			<a
				href={whatsappHref(TELEFONO2.numero, lang)}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105"
			>
				{t.contact.ctaWhatsapp}
			</a>
		</div>

		<div class="contacto-form mt-10 rounded-3xl border border-gtm-navy/10 bg-gtm-surface p-6 shadow-2xl shadow-gtm-navy/10 backdrop-blur-sm sm:p-8 lg:p-10">
			<div class="max-w-2xl">
				<h3 class="font-display text-2xl font-semibold text-gtm-navy sm:text-3xl">
					{t.contact.form.heading}
				</h3>
				<p class="mt-3 text-base leading-relaxed text-slate-700">
					{t.contact.form.intro}
				</p>
			</div>

			<form id="contact-form" class="mt-8 grid gap-5 sm:grid-cols-2" action="https://api.web3forms.com/submit" method="POST">
				<input type="hidden" name="access_key" value={CONTACT_FORM_CONFIG.accessKey} />
				<input type="hidden" name="subject" value={CONTACT_FORM_CONFIG.contact.subject} />
				<input type="hidden" name="from_name" value={CONTACT_FORM_CONFIG.fromName} />
				<input type="hidden" name="idioma" value={lang} />
				<input
					type="checkbox"
					name="botcheck"
					class="hidden"
					style="display: none;"
					tabindex="-1"
					autocomplete="off"
				/>

				<div class="sm:col-span-2">
					<label for="nombre" class="mb-2 block text-sm font-medium text-slate-700">
						{t.contact.form.nombreLabel}
					</label>
					<input
						id="nombre"
						name="name"
						type="text"
						required
						class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
						placeholder={t.contact.form.nombrePlaceholder}
					/>
				</div>

				<div>
					<label for="email" class="mb-2 block text-sm font-medium text-slate-700">
						{t.contact.form.emailLabel}
					</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
						placeholder={t.contact.form.emailPlaceholder}
					/>
				</div>

				<div>
					<label for="telefono" class="mb-2 block text-sm font-medium text-slate-700">
						{t.contact.form.telefonoLabel}
					</label>
					<input
						id="telefono"
						name="telefono"
						type="tel"
						class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
						placeholder={t.contact.form.telefonoPlaceholder}
					/>
				</div>

				<div class="sm:col-span-2">
					<label for="mensaje" class="mb-2 block text-sm font-medium text-slate-700">
						{t.contact.form.mensajeLabel}
					</label>
					<textarea
						id="mensaje"
						name="message"
						rows="5"
						class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
						placeholder={t.contact.form.mensajePlaceholder}
					></textarea>
				</div>

				<div class="sm:col-span-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<button
						id="contact-submit"
						type="submit"
						class="inline-flex items-center justify-center rounded-full bg-gtm-gold px-7 py-3 text-sm font-semibold text-gtm-navy transition-transform hover:scale-[1.02] disabled:cursor-not-allowed disabled:opacity-60"
					>
						{t.contact.form.submit}
					</button>
					<p
						id="contact-form-status"
						class="text-sm text-slate-500"
						role="status"
						aria-live="polite"
						data-status-default={t.contact.form.statusDefault}
						data-status-sending={t.contact.form.statusSending}
						data-status-success={t.contact.form.statusSuccess}
						data-status-error-prefix={t.contact.form.statusErrorPrefix}
						data-status-error-fallback={t.contact.form.statusErrorFallback}
						data-status-error-unexpected={t.contact.form.statusErrorUnexpected}
						data-status-missing-key={t.contact.form.statusMissingKey}
						data-sending-label={t.contact.form.sending}
						data-submit-label={t.contact.form.submit}
					>
						{t.contact.form.statusDefault}
					</p>
				</div>

			</form>
		</div>
	</div>

	<div id="contact-privacy-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-gtm-navy/40 px-4 backdrop-blur-sm">
		<div class="w-full max-w-lg rounded-3xl border border-gtm-navy/10 bg-gtm-surface p-6 shadow-2xl shadow-gtm-navy/15 sm:p-8">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-gtm-gold-ink">{t.contact.privacyModal.eyebrow}</p>
			<h3 class="mt-3 font-display text-2xl font-semibold text-gtm-navy">{t.contact.privacyModal.title}</h3>
			<p class="mt-3 text-sm leading-relaxed text-slate-700">
				{t.contact.privacyModal.body}
			</p>
			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
				<button id="contact-cancel-policy" type="button" class="rounded-full border border-gtm-navy/20 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-gtm-navy/5">
					{t.contact.privacyModal.cancel}
				</button>
				<button id="contact-accept-policy" type="button" class="rounded-full bg-gtm-gold px-5 py-2.5 text-sm font-semibold text-gtm-navy transition-transform hover:scale-[1.02]">
					{t.contact.privacyModal.accept}
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	const form = document.querySelector('#contact-form') as HTMLFormElement | null;
	const statusEl = document.getElementById('contact-form-status');
	const modal = document.getElementById('contact-privacy-modal');
	const cancelButton = document.getElementById('contact-cancel-policy');
	const acceptButton = document.getElementById('contact-accept-policy');
	const accessKey = (form?.querySelector('[name="access_key"]') as HTMLInputElement | null)?.value.trim() ?? '';

	// Textos localizados, pasados desde el frontmatter vía `data-*` en
	// `#contact-form-status` (un `<script>` de navegador no puede resolver
	// `Astro.currentLocale`).
	const i18nText = {
		default: statusEl?.dataset.statusDefault ?? '',
		sending: statusEl?.dataset.statusSending ?? '',
		success: statusEl?.dataset.statusSuccess ?? '',
		errorPrefix: statusEl?.dataset.statusErrorPrefix ?? '',
		errorFallback: statusEl?.dataset.statusErrorFallback ?? '',
		errorUnexpected: statusEl?.dataset.statusErrorUnexpected ?? '',
		missingKey: statusEl?.dataset.statusMissingKey ?? '',
		sendingLabel: statusEl?.dataset.sendingLabel ?? '',
		submitLabel: statusEl?.dataset.submitLabel ?? '',
	};

	function setStatus(message: string, tone: 'default' | 'error' | 'success') {
		if (!statusEl) return;

		statusEl.textContent = message;
		statusEl.classList.remove('text-red-600', 'text-emerald-700', 'text-slate-500');

		if (tone === 'error') {
			statusEl.classList.add('text-red-600');
		} else if (tone === 'success') {
			statusEl.classList.add('text-emerald-700');
		} else {
			statusEl.classList.add('text-slate-500');
		}
	}

	async function submitForm(formElement: HTMLFormElement) {
		const submitButton = formElement.querySelector('button[type="submit"]') as HTMLButtonElement | null;
		const originalText = submitButton?.textContent;

		if (submitButton) {
			submitButton.disabled = true;
			submitButton.textContent = i18nText.sendingLabel;
		}

		setStatus(i18nText.sending, 'default');

		try {
			const formData = new FormData(formElement);
			const payload = Object.fromEntries(formData.entries());

			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					Accept: 'application/json',
				},
				body: JSON.stringify(payload),
			});

			const result = await response.json().catch(() => ({
				success: false,
				message: i18nText.errorUnexpected,
			}));

			if (response.ok && result.success) {
				formElement.reset();
				setStatus(i18nText.success, 'success');
			} else {
				throw new Error(result.message ?? i18nText.errorFallback);
			}
		} catch (error) {
			const message = error instanceof Error ? error.message : i18nText.errorFallback;
			console.error('Web3Forms submit failed', error);
			setStatus(`${i18nText.errorPrefix} ${message}`, 'error');
		} finally {
			if (submitButton) {
				submitButton.disabled = false;
				submitButton.textContent = originalText ?? i18nText.submitLabel;
			}
		}
	}

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		modal?.classList.remove('hidden');
		modal?.classList.add('flex');
	});

	cancelButton?.addEventListener('click', () => {
		modal?.classList.add('hidden');
		modal?.classList.remove('flex');
	});

	acceptButton?.addEventListener('click', async () => {
		modal?.classList.add('hidden');
		modal?.classList.remove('flex');

		if (!form) return;

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		if (!accessKey) {
			setStatus(i18nText.missingKey, 'error');
			return;
		}

		await submitForm(form);
	});

	form?.addEventListener('input', () => {
		setStatus(i18nText.default, 'default');
	});
</script>
