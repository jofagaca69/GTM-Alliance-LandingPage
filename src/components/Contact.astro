---
import { TELEFONO, CORREOS, SEDE_PRINCIPAL } from '../data/contact';

const iconoUbicacion =
	'<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>';
const iconoCorreo =
	'<path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>';
const iconoTelefono =
	'<path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>';

const contactos = [
	{
		label: 'Sede',
		value: `${SEDE_PRINCIPAL.direccion}, ${SEDE_PRINCIPAL.ciudad}`,
		href: undefined,
		icon: iconoUbicacion,
	},
	{
		label: 'Teléfono',
		value: TELEFONO.label,
		href: TELEFONO.href,
		icon: iconoTelefono,
	},
	{
		label: 'Gerencia',
		value: CORREOS.gerencia,
		href: `mailto:${CORREOS.gerencia}`,
		icon: iconoCorreo,
	},
	{
		label: 'Administración',
		value: CORREOS.administracion,
		href: `mailto:${CORREOS.administracion}`,
		icon: iconoCorreo,
	},
];
---

<section id="contacto" class="bg-transparent py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<span
			class="contacto-eyebrow font-display inline-block text-xs font-semibold tracking-widest text-gtm-gold uppercase"
		>
			Contacto
		</span>
		<h2
			class="contacto-title font-display mt-3 max-w-3xl text-3xl leading-tight font-bold text-white sm:text-4xl lg:text-5xl"
		>
			Conversemos sobre tus necesidades logísticas
		</h2>
		<p class="contacto-intro mt-4 max-w-3xl text-base leading-relaxed text-slate-300 lg:text-lg">
			Estamos listos para acompañarte en tus proyectos de comercio exterior y exportación.
		</p>

		<div class="mt-10 grid grid-cols-1 gap-6 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
			{
				contactos.map((item) => {
					const Tag = item.href ? 'a' : 'div';
					return (
						<Tag
							href={item.href}
							class="contacto-card group flex flex-col gap-4 rounded-2xl bg-white/5 p-8 ring-1 ring-white/10 backdrop-blur-sm transition-colors hover:bg-white/10"
						>
							<span
								set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">${item.icon}</svg>`}
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-gtm-gold ring-1 ring-white/20"
							/>
							<div>
								<span class="font-display text-xs font-semibold tracking-widest text-gtm-gold uppercase">
									{item.label}
								</span>
								<p class="mt-2 text-base font-semibold text-white transition-colors group-hover:text-gtm-gold">
									{item.value}
								</p>
							</div>
						</Tag>
					);
				})
			}
		</div>

		<div class="contacto-cta mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-start">
			<a
				href={TELEFONO.whatsapp}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105"
			>
				Escribir por WhatsApp
			</a>
			<a
				href={`mailto:${CORREOS.gerencia}`}
				class="rounded-full border border-white/40 px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
			>
				Enviar correo
			</a>
		</div>

		<div class="contacto-form mt-10 rounded-3xl border border-white/10 bg-slate-950/50 p-6 shadow-2xl shadow-black/20 backdrop-blur-sm sm:p-8 lg:p-10">
			<div class="max-w-2xl">
				<h3 class="font-display text-2xl font-semibold text-white sm:text-3xl">
					Envíanos un mensaje
				</h3>
				<p class="mt-3 text-base leading-relaxed text-slate-300">
					Completa este formulario y te responderemos con una solución a medida para tu operación.
				</p>
			</div>

			<form id="contact-form" class="mt-8 grid gap-5 sm:grid-cols-2" action="#" method="post">
				<div class="sm:col-span-2">
					<label for="nombre" class="mb-2 block text-sm font-medium text-slate-200">
						Nombre Completo*
					</label>
					<input
						id="nombre"
						name="nombre"
						type="text"
						required
						class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder:text-slate-400 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
						placeholder="Tu nombre"
					/>
				</div>

				<div>
					<label for="email" class="mb-2 block text-sm font-medium text-slate-200">
						Email*
					</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder:text-slate-400 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
						placeholder="tu@email.com"
					/>
				</div>

				<div>
					<label for="telefono" class="mb-2 block text-sm font-medium text-slate-200">
						Teléfono*
					</label>
					<input
						id="telefono"
						name="telefono"
						type="tel"
						class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder:text-slate-400 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
						placeholder="+57 300 000 0000"
					/>
				</div>

				<div class="sm:col-span-2">
					<label for="mensaje" class="mb-2 block text-sm font-medium text-slate-200">
						Mensaje
					</label>
					<textarea
						id="mensaje"
						name="mensaje"
						rows="5"
						class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder:text-slate-400 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
						placeholder="Cuéntanos sobre tu proyecto, carga o destino..."
					></textarea>
				</div>

				<div class="sm:col-span-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<button
						type="submit"
						class="inline-flex items-center justify-center rounded-full bg-gtm-gold px-7 py-3 text-sm font-semibold text-gtm-navy transition-transform hover:scale-[1.02]"
					>
						Enviar mensaje
					</button>
					<p class="text-sm text-slate-400">
						Responderemos en menos de 24 horas.
					</p>
				</div>
				
			</form>
		</div>
	</div>

	<div id="contact-privacy-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 px-4 backdrop-blur-sm">
		<div class="w-full max-w-lg rounded-3xl border border-white/10 bg-slate-900 p-6 shadow-2xl shadow-black/30 sm:p-8">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-gtm-gold">Tratamiento de datos</p>
			<h3 class="mt-3 font-display text-2xl font-semibold text-white">Confirmar envío del mensaje</h3>
			<p class="mt-3 text-sm leading-relaxed text-slate-300">
				Al enviar este formulario autorizas que GTM Alliance procese tus datos para responder tu solicitud, gestionar la información de contacto y atender tu consulta. Tus datos no serán compartidos con terceros sin tu autorización, salvo obligación legal.
			</p>
			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
				<button id="contact-cancel-policy" type="button" class="rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:bg-white/10">
					Cancelar
				</button>
				<button id="contact-accept-policy" type="button" class="rounded-full bg-gtm-gold px-5 py-2.5 text-sm font-semibold text-gtm-navy transition-transform hover:scale-[1.02]">
					Aceptar y enviar
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#contacto');
	const form = document.querySelector('#contact-form') as HTMLFormElement | null;
	const modal = document.getElementById('contact-privacy-modal');
	const cancelButton = document.getElementById('contact-cancel-policy');
	const acceptButton = document.getElementById('contact-accept-policy');
	let formReadyToSubmit = false;

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		modal?.classList.remove('hidden');
		modal?.classList.add('flex');
	});

	cancelButton?.addEventListener('click', () => {
		modal?.classList.add('hidden');
		modal?.classList.remove('flex');
	});

	acceptButton?.addEventListener('click', () => {
		formReadyToSubmit = true;
		modal?.classList.add('hidden');
		modal?.classList.remove('flex');
		if (form && formReadyToSubmit) {
			form.submit();
		}
	});

	if (section) {
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo('.contacto-eyebrow', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5 })
				.fromTo(
					'.contacto-title',
					{ opacity: 0, y: 24 },
					{ opacity: 1, y: 0, duration: 0.7 },
					'-=0.3',
				)
				.fromTo(
					'.contacto-intro',
					{ opacity: 0, y: 24 },
					{ opacity: 1, y: 0, duration: 0.7 },
					'-=0.5',
				)
				.fromTo(
					'.contacto-card',
					{ opacity: 0, y: 32 },
					{ opacity: 1, y: 0, duration: 0.6, stagger: 0.15 },
					'-=0.3',
				)
				.fromTo(
					'.contacto-cta',
					{ opacity: 0, y: 20 },
					{ opacity: 1, y: 0, duration: 0.6 },
					'-=0.2',
				)
				.fromTo(
					'.contacto-form',
					{ opacity: 0, y: 24 },
					{ opacity: 1, y: 0, duration: 0.7 },
					'-=0.2',
				);

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(
				['.contacto-eyebrow', '.contacto-title', '.contacto-intro', '.contacto-card', '.contacto-cta', '.contacto-form'],
				{ opacity: 1, y: 0 },
			);
		});
	}
</script>
