---
interface Props {
	titulo: string;
	descripcion?: string;
	etiqueta?: string;
	ctaLabel?: string;
	ctaHref?: string;
}

const { titulo, descripcion, etiqueta = 'Próximamente', ctaLabel, ctaHref } = Astro.props;
---

<div class="coming-soon-cover relative">
	<div inert aria-hidden="true" class="pointer-events-none blur-[6px] opacity-70 select-none">
		<slot />
	</div>

	<div class="pointer-events-none absolute inset-0 z-10 flex items-start justify-center px-4 pt-8 sm:pt-12">
		<div class="absolute inset-0 bg-gtm-deep/40"></div>

		<div
			class="coming-soon-card pointer-events-auto flex max-w-md flex-col items-center rounded-2xl bg-gtm-navy/80 px-8 py-10 text-center shadow-2xl shadow-black/40 ring-1 ring-gtm-gold/30 backdrop-blur-sm"
		>
			<span class="font-display text-xs font-semibold tracking-widest text-gtm-gold uppercase">
				{etiqueta}
			</span>
			<h3 class="font-display mt-3 text-2xl font-bold text-white sm:text-3xl">
				{titulo}
			</h3>
			{descripcion && <p class="mt-3 text-sm leading-relaxed text-slate-300">{descripcion}</p>}
			{
				ctaLabel && ctaHref && (
					<a
						href={ctaHref}
						class="mt-6 rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gtm-gold"
					>
						{ctaLabel}
					</a>
				)
			}
		</div>
	</div>
</div>

<script>
	import { gsap } from '../scripts/gsap';

	const covers = document.querySelectorAll('.coming-soon-cover');

	covers.forEach((cover) => {
		const card = cover.querySelector('.coming-soon-card');
		if (!card) return;

		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tween = gsap.fromTo(
				card,
				{ opacity: 0, y: 16 },
				{
					opacity: 1,
					y: 0,
					duration: 0.6,
					ease: 'power3.out',
					scrollTrigger: { trigger: cover, start: 'top 85%' },
				},
			);

			return () => {
				tween.scrollTrigger?.kill();
				tween.kill();
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(card, { opacity: 1, y: 0 });
		});
	});
</script>
