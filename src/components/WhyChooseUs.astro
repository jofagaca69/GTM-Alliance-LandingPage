---
import { Image } from 'astro:assets';
import macrorrueda from '../assets/eventos/macrorrueda.jpeg';
import colombiaCo from '../assets/eventos/alimentec.jpg';
import americas from '../assets/eventos/americas.png';
import invimaLogo from '../assets/logos/invima.jpg';
import fdaLogo from '../assets/logos/fda.png';
import paises from '../assets/flags/paises.jpg';
import { getLocale, useTranslations } from '../i18n/utils';

const t = useTranslations(getLocale(Astro.url));

const ICONS = {
	// Insignia de certificación — copiado del sello "calidad" de FrozenLine.astro (huérfano, nunca renderizado ahí).
	sello: '<circle cx="12" cy="8.5" r="5.25"/><path d="M9.25 8.5l1.85 1.85L14.75 6.5"/><path d="M9 13.25L7.25 19.5 12 17l4.75 2.5-1.75-6.25"/>',
	escudo: '<path d="M12 3l7 3.2v5.3c0 4.9-3.1 8.4-7 9.5-3.9-1.1-7-4.6-7-9.5V6.2L12 3z"/><path d="M9 12l2 2 4-4.5"/>',
	// Copo de nieve — copiado de "cadenaFrio" en FrozenLine.astro.
	frio: '<path d="M12 2.5v19M4.5 7l15 10M4.5 17L19.5 7"/><path d="M12 6.25l-1.75 1.05M12 6.25l1.75 1.05M12 17.75l-1.75-1.05M12 17.75l1.75-1.05M7.1 9.3l.3-2.05M7.1 9.3l-1.9.8M16.9 9.3l-.3-2.05M16.9 9.3l1.9.8M7.1 14.7l.3 2.05M7.1 14.7l-1.9-.8M16.9 14.7l-.3 2.05M16.9 14.7l1.9-.8"/>',
	normativo: '<rect x="6" y="4" width="12" height="16" rx="2"/><path d="M9 4V3.5A1.5 1.5 0 0110.5 2h3A1.5 1.5 0 0115 3.5V4"/><path d="M9 13l2 2 4-4.5"/>',
	alianza: '<circle cx="9" cy="12" r="5"/><circle cx="15" cy="12" r="5"/>',
	// Pin de alcance — copiado de "alcance" en FrozenLine.astro.
	alcance: '<path d="M12 21s7-7.6 7-12.75A7 7 0 105 8.25C5 13.4 12 21 12 21z"/><circle cx="12" cy="8.25" r="2.5"/>',
	// Piezas para armar consolidación de carga / marca / gestión de exportación.
	consolidacion: '<rect x="3.5" y="8" width="17" height="12" rx="1.5"/><path d="M3.5 12.5h17M8 8V6a2 2 0 012-2h4a2 2 0 012 2v2"/>',
	marca: '<path d="M11 3H4.8A1.8 1.8 0 003 4.8V11c0 .48.19.93.53 1.27l8.4 8.4a1.8 1.8 0 002.54 0l6.2-6.2a1.8 1.8 0 000-2.54l-8.4-8.4A1.8 1.8 0 0011 3z"/><circle cx="7.5" cy="7.5" r="1.4"/>',
	experiencia: '<path d="M12 21s7-7.6 7-12.75A7 7 0 105 8.25C5 13.4 12 21 12 21z"/><circle cx="12" cy="8.25" r="2.5"/>',
	gestion: '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 8h6M9 12h6M9 16h3.5"/>',
};

function svg(path: string, cls = 'h-6 w-6') {
	return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${cls}">${path}</svg>`;
}

const mercados = t.whyChooseUs.mercados;

const certificaciones = [
	{ ...t.whyChooseUs.certificaciones[0], logo: invimaLogo },
	{ ...t.whyChooseUs.certificaciones[1], logo: fdaLogo },
];

const eventos = [
	{
		...t.whyChooseUs.eventos[0],
		image: colombiaCo,
		posicion: 'object-[center_38%]',
	},
	{
		...t.whyChooseUs.eventos[1],
		image: macrorrueda,
		posicion: 'object-[center_18%]',
	},
];

const pilares = [
	{ ...t.whyChooseUs.pilares[0], icon: ICONS.consolidacion },
	{ ...t.whyChooseUs.pilares[1], icon: ICONS.marca },
	{ ...t.whyChooseUs.pilares[2], icon: ICONS.experiencia },
	{ ...t.whyChooseUs.pilares[3], icon: ICONS.gestion },
];

const chips = [
	{ ...t.whyChooseUs.chips[0], icon: ICONS.escudo },
	{ ...t.whyChooseUs.chips[1], icon: ICONS.frio },
	{ ...t.whyChooseUs.chips[2], icon: ICONS.normativo },
	{ ...t.whyChooseUs.chips[3], icon: ICONS.alianza },
	{ ...t.whyChooseUs.chips[4], icon: ICONS.alcance },
];
---

<section id="por-que-elegirnos" class="bg-transparent py-10 sm:py-10">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<span
			class="elegir-eyebrow font-display inline-block text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase"
		>
			{t.whyChooseUs.eyebrow}
		</span>
		<h2
			class="elegir-title font-display mt-3 max-w-3xl text-3xl leading-tight font-bold text-gtm-navy sm:text-4xl lg:text-5xl"
		>
			{t.whyChooseUs.title}
		</h2>
		<p class="elegir-intro mt-4 max-w-3xl text-base leading-relaxed text-slate-700 lg:text-lg">
			{t.whyChooseUs.intro}
		</p>

		<!-- Experiencia internacional + Certificaciones -->
		<div class="mt-12 grid gap-6 sm:mt-16 lg:grid-cols-[1.35fr_1fr]">
			<div class="elegir-panel relative overflow-hidden rounded-3xl bg-[#0a1220] lg:min-h-[22rem]">
				<div class="relative aspect-[960/563] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full">
					<Image
						src={paises}
						alt={t.whyChooseUs.mapaAlt}
						widths={[480, 640, 800, 960]}
						sizes="(min-width: 1024px) 620px, 100vw"
						loading="lazy"
						class="h-full w-full object-cover object-center"
					/>
				</div>
				<div class="relative z-10 flex flex-col justify-between p-6 lg:min-h-[22rem] lg:p-8">
					<div>
						<h3 class="font-display text-xl font-bold text-white [text-shadow:0_2px_14px_rgba(10,18,32,0.9)] sm:text-2xl">
							{t.whyChooseUs.experienciaTitlePrefix} <span class="text-gtm-gold">{t.whyChooseUs.experienciaTitle}</span>
						</h3>
					</div>
					<!-- <ul class="mt-5 space-y-3 sm:mt-4">
						{
							mercados.map((mercado) => (
								<li>
									<p class="font-display text-sm font-bold text-white [text-shadow:0_1px_10px_rgba(10,18,32,0.9)]">{mercado.nombre}</p>
									<p class="text-sm leading-snug text-white [text-shadow:0_1px_8px_rgba(10,18,32,0.85)]">{mercado.descripcion}</p>
								</li>
							))
						}
					</ul> -->
				</div>
			</div>

			<div class="elegir-cert rounded-3xl bg-gtm-surface p-6 ring-1 ring-gtm-navy/10 sm:p-8">
				<h3 class="font-display text-xl font-bold text-gtm-navy sm:text-2xl">{t.whyChooseUs.certificacionesTitle}</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-600">{t.whyChooseUs.certificacionesSubtitle}</p>
				<div class="mt-6 grid grid-cols-2 gap-4">
					{
						certificaciones.map((cert) => (
							<div class="flex flex-col items-center gap-2 rounded-2xl border border-gtm-navy/10 px-3 py-5 text-center">
								{cert.logo ? (
									<Image
										src={cert.logo}
										alt={cert.alt}
										height={64}
										densities={[1, 2]}
										loading="lazy"
										class="h-16 w-auto max-w-full object-contain"
									/>
								) : (
									<span
										set:html={svg(ICONS.sello, 'h-7 w-7')}
										class="flex h-11 w-11 items-center justify-center rounded-full bg-gtm-navy/5 text-gtm-gold-ink ring-1 ring-gtm-navy/10"
										aria-hidden="true"
									/>
								)}
								<span class="font-display text-sm font-bold text-gtm-navy">{cert.nombre}</span>
								<span class="text-xs leading-snug text-slate-600">{cert.descripcion}</span>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<!-- Presentes en los eventos más importantes del sector -->
		<div class="elegir-eventos mt-12 sm:mt-16">
			<div class="flex items-center gap-4">
				<span class="h-px flex-1 bg-gtm-navy/15" aria-hidden="true"></span>
				<h3 class="font-display shrink-0 text-center text-lg font-bold tracking-tight text-gtm-navy sm:text-xl">
					{t.whyChooseUs.eventosTitle}
				</h3>
				<span class="h-px flex-1 bg-gtm-navy/15" aria-hidden="true"></span>
			</div>

			<div class="mt-6 grid gap-4 sm:mt-8 sm:grid-cols-2 lg:grid-cols-3">
				{
					eventos.map((evento) => (
						<div class="elegir-evento group relative aspect-[1063/650] overflow-hidden rounded-2xl ring-1 ring-gtm-navy/10">
							<Image
								src={evento.image}
								alt={evento.alt}
								widths={[400, 600, 800]}
								sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
								loading="lazy"
								class={`h-full w-full object-cover ${evento.posicion}`}
							/>
							<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent" />
							<div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
								<span class="font-display inline-block rounded-full bg-gtm-gold px-2.5 py-0.5 text-[0.65rem] font-bold tracking-wide text-gtm-navy uppercase">
									{evento.etiqueta}
								</span>
								<h4 class="font-display mt-2 text-base font-bold text-white sm:text-lg">{evento.nombre}</h4>
								<p class="mt-1 text-xs leading-snug text-slate-200 sm:text-sm">{evento.descripcion}</p>
							</div>
						</div>
					))
				}

				<div class="elegir-evento relative aspect-[1063/650] overflow-hidden rounded-2xl bg-white ring-1 ring-gtm-navy/10">
					<Image
						src={americas}
						alt={t.whyChooseUs.americasAlt}
						widths={[400, 600, 800]}
						sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
						loading="lazy"
						class="h-full w-full object-contain object-center"
					/>
					<span
						class="font-display absolute top-4 right-4 z-10 inline-flex max-w-[calc(100%-2rem)] items-center gap-1.5 rounded-full bg-gtm-gold px-2.5 py-0.5 text-[0.65rem] font-bold tracking-wide text-gtm-navy uppercase shadow-sm"
					>
						<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-gtm-navy" aria-hidden="true"></span>
						{t.whyChooseUs.proximamenteLabel}
					</span>
				</div>
			</div>


		</div>

		<!-- ¿Por qué elegir GTM Alliance? -->
		<div class="elegir-pilares mt-12 sm:mt-16">
			<h3 class="font-display text-center text-2xl font-bold text-gtm-navy sm:text-3xl">
				{t.whyChooseUs.pilaresTitlePrefix} <span class="text-gtm-gold-ink">{t.whyChooseUs.pilaresTitleHighlight}</span>{t.whyChooseUs.pilaresTitleSuffix}
			</h3>
			<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{
					pilares.map((pilar) => (
						<div class="elegir-pilar flex flex-col items-center gap-3 text-center">
							<span
								set:html={svg(pilar.icon)}
								class="flex h-14 w-14 items-center justify-center rounded-full bg-gtm-navy/5 text-gtm-gold-ink ring-1 ring-gtm-navy/10"
								aria-hidden="true"
							/>
							<h4 class="font-display text-sm font-bold text-gtm-navy">{pilar.titulo}</h4>
							<p class="text-sm leading-relaxed text-slate-600">{pilar.descripcion}</p>
						</div>
					))
				}
			</div>
		</div>

		<!-- Franja de confianza -->
		<div class="elegir-chips mt-12 rounded-2xl bg-[linear-gradient(160deg,#1c2f4a_0%,#0a1220_100%)] px-6 py-6 sm:mt-16 sm:px-8">
			<ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
				{
					chips.map((chip) => (
						<li class="flex items-center gap-2.5">
							<span set:html={svg(chip.icon, 'h-5 w-5')} class="shrink-0 text-gtm-gold" aria-hidden="true" />
							<span class="text-sm font-medium text-slate-200">{chip.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#por-que-elegirnos');

	if (section) {
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo('.elegir-eyebrow', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 })
				.fromTo('.elegir-title', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.4')
				.fromTo('.elegir-intro', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.5')
				.fromTo(
					['.elegir-panel', '.elegir-cert'],
					{ opacity: 0, y: 32 },
					{ opacity: 1, y: 0, duration: 0.6, stagger: 0.1 },
					'-=0.3',
				)
				.fromTo('.elegir-eventos', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.5 }, '-=0.2')
				.fromTo('.elegir-evento', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1 }, '-=0.3')
				.fromTo('.elegir-pilares', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.5 }, '-=0.2')
				.fromTo('.elegir-pilar', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.4, stagger: 0.08 }, '-=0.3')
				.fromTo('.elegir-chips', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5 }, '-=0.2');

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(
				[
					'.elegir-eyebrow',
					'.elegir-title',
					'.elegir-intro',
					'.elegir-panel',
					'.elegir-cert',
					'.elegir-eventos',
					'.elegir-evento',
					'.elegir-pilares',
					'.elegir-pilar',
					'.elegir-chips',
				],
				{ opacity: 1, y: 0 },
			);
		});
	}
</script>
