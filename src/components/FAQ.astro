---
import { TELEFONO, CORREOS } from '../data/contact';

/* Preguntas frecuentes: contenido nuevo, con respuestas ancladas solo en
   hechos ya publicados en el resto del sitio (servicios, líneas de negocio,
   sede y canales de contacto). No se afirman certificaciones, cifras ni
   plazos que el cliente no haya confirmado. */
const preguntas = [
	{
		pregunta: '¿Qué tipos de carga transporta GTM Alliance?',
		respuesta:
			'Manejamos carga seca multi-industria (alimentos, dulces, consumo masivo, productos de aluminio) y carga refrigerada, en alianza con Coldfood, con cadena de frío monitoreada del agricultor al destino final. El transporte se realiza por vía marítima, aérea y terrestre según la operación.',
	},
	{
		pregunta: '¿Qué es el agenciamiento aduanero y por qué lo necesito?',
		respuesta:
			'Es la gestión de los trámites, documentación y requisitos normativos que exige una operación de importación o exportación ante las autoridades aduaneras. Contar con una agencia de aduanas reduce el riesgo de retrasos, sanciones o retención de mercancía en frontera.',
	},
	{
		pregunta: '¿En cuánto tiempo responden una solicitud de cotización?',
		respuesta:
			'Respondemos los mensajes enviados por el formulario de contacto en menos de 24 horas. Para consultas urgentes, el canal más rápido es WhatsApp.',
	},
	{
		pregunta: '¿Desde dónde opera GTM Alliance?',
		respuesta:
			'Nuestra sede principal está en Bogotá D.C., Colombia. Estamos preparando una expansión de la línea de carga seca hacia Medellín.',
	},
	{
		pregunta: '¿Cómo se diferencia la consolidación de carga del transporte internacional?',
		respuesta:
			'El transporte internacional mueve tu carga de origen a destino por mar, aire o tierra. La consolidación de carga agrupa envíos de distintos orígenes o clientes en una sola operación antes de ese transporte, lo que reduce costos y tiempos cuando el volumen individual no llena un contenedor completo.',
	},
	{
		pregunta: '¿Cómo presento una petición, queja, reclamo o sugerencia (PQRSD)?',
		respuesta:
			'A través del formulario de PQRSD, disponible en una página dedicada, donde puedes seleccionar el tipo de solicitud y describir tu caso para que le demos seguimiento.',
	},
];
---

<section id="preguntas-frecuentes" class="bg-transparent py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<span
			class="faq-eyebrow font-display inline-block text-xs font-semibold tracking-widest text-gtm-gold uppercase"
		>
			Preguntas frecuentes
		</span>
		<h2
			class="faq-title font-display mt-3 max-w-3xl text-3xl leading-tight font-bold text-white sm:text-4xl lg:text-5xl"
		>
			Resolvemos tus dudas sobre comercio exterior y logística
		</h2>
		<p class="faq-intro mt-4 max-w-3xl text-base leading-relaxed text-slate-300 lg:text-lg">
			Si tu pregunta no está aquí, escríbenos por{' '}
			<a href={TELEFONO.whatsapp} target="_blank" rel="noopener noreferrer" class="text-gtm-gold hover:underline">
				WhatsApp
			</a>{' '}
			o al correo{' '}
			<a href={`mailto:${CORREOS.gerencia}`} class="text-gtm-gold hover:underline">
				{CORREOS.gerencia}
			</a>.
		</p>

		<div class="mt-10 grid grid-cols-1 gap-6 sm:mt-16 md:grid-cols-2">
			{
				preguntas.map((item) => (
					<div class="faq-card rounded-2xl bg-white/5 p-8 ring-1 ring-white/10 backdrop-blur-sm">
						<h3 class="font-display text-lg font-bold text-white">{item.pregunta}</h3>
						<p class="mt-3 text-sm leading-relaxed text-slate-300">{item.respuesta}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#preguntas-frecuentes');

	if (section) {
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo('.faq-eyebrow', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5 })
				.fromTo('.faq-title', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.3')
				.fromTo(
					'.faq-intro',
					{ opacity: 0, y: 24 },
					{ opacity: 1, y: 0, duration: 0.7 },
					'-=0.5',
				)
				.fromTo(
					'.faq-card',
					{ opacity: 0, y: 32 },
					{ opacity: 1, y: 0, duration: 0.6, stagger: 0.1 },
					'-=0.3',
				);

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(['.faq-eyebrow', '.faq-title', '.faq-intro', '.faq-card'], { opacity: 1, y: 0 });
		});
	}
</script>
