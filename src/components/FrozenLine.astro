---
import { Image } from 'astro:assets';
import coldfoodLogo from '../assets/logos/coldfood.png';
import cadenaFrio from '../assets/congelados/cadena-frio.png';
import lineaFrescos from '../assets/congelados/linea-frescos.png';
import lineaPrecocidos from '../assets/congelados/linea-precocidos.png';
import lineaCongelados from '../assets/congelados/linea-congelados.png';

const PASO_ICONS = {
	origen: '<path d="M12 21V10"/><path d="M12 10C12 6.5 9.5 4 6 4c0 3.5 2.5 6 6 6z"/><path d="M12 13c0-4 3-7 7-7 0 4-3 7-7 7z"/>',
	produccion:
		'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
	marca:
		'<path d="M11 3H4.8A1.8 1.8 0 003 4.8V11c0 .48.19.93.53 1.27l8.4 8.4a1.8 1.8 0 002.54 0l6.2-6.2a1.8 1.8 0 000-2.54l-8.4-8.4A1.8 1.8 0 0011 3z"/><circle cx="7.5" cy="7.5" r="1.4"/>',
	exportacion: '<path d="M4 15.5l1 4h14l1-4"/><path d="M6.5 15.5V8.5h3l2.5-2.5 2.5 2.5h3v7"/><path d="M12 6V3"/>',
};

const pasos = [
	{ num: '01',
	 titulo: 'Productores colombianos ', 
	 descripcion: 'Materias primas de calidad.', 
	 icon: PASO_ICONS.origen },
	{
		num: '02',
		titulo: 'Procesamiento especializado',
		descripcion: 'Calidad y congelacion controlada.',
		icon: PASO_ICONS.produccion,
	},
	{
		num: '03',
		titulo: 'Marca privada o propia',
		descripcion: 'Empaques adaptados a tu mercado.',
		icon: PASO_ICONS.marca,
	},
	{
		num: '04',
		titulo: 'Exportacion internacional',
		descripcion: 'Logística para mercados internacionales.',
		icon: PASO_ICONS.exportacion,
	},
];

const lineas = [
	{
		label: 'Frescos',
		descriptor: 'Productos seleccionados y congelados para conservar su sabor, textura y calidad natural.',
		image: lineaFrescos,
		alt: 'Productos frescos de la línea GTM Alliance: yuca, plátano verde, lulo y mora empacados con marca propia',
		productos: ['Yuca', 'Plátano Verde', 'Lulo', 'Mora', 'Guayaba'],
	},
	{
		label: 'Prefritos',
		descriptor: 'Productos con valor agregado, elaborados para ofrecer practicidad, textura y sabor en cada preparación.',
		image: lineaPrecocidos,
		alt: 'Productos precocidos de la línea GTM Alliance: croquetas y francesa de yuca, tajadas, plátanos maduros y tostones empacados con marca propia',
		productos: ['Yuca Croqueta', 'Yuca Francesa', 'Tajadas', 'Plátanos Maduros', 'Tostones'],
	},
	{
		label: 'Precocidos',
		descriptor: 'Prácticos y listos para preparar, conservando el sabor y las características tradicionales de cada producto.',
		image: lineaCongelados,
		alt: 'Productos congelados de la línea GTM Alliance: papa criolla, yuca stick, arracacha y mixes de vegetales empacados con marca propia',
		productos: ['Papa Criolla','Yuca Stick','Arracacha', 'Mix de Sancocho', 'Mix de Ajiaco'],
	},
];
---

<section id="congelados" class="bg-transparent py-10 sm:py-10">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="congelados-hero overflow-hidden rounded-3xl bg-gtm-surface ring-1 ring-gtm-navy/10">
			<div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:items-center lg:gap-10 lg:p-10">
				<div class="lg:col-span-5">
					<div class="flex items-center gap-3">
						<Image
							src={coldfoodLogo}
							alt="Coldfood"
							height={36}
							densities={[1, 2]}
							loading="lazy"
							class="h-8 w-auto object-contain"
						/>
						<span class="text-xs font-medium text-slate-500">En alianza con Coldfood</span>
					</div>
					<h2 class="font-display mt-4 text-3xl leading-tight font-bold text-gtm-navy sm:text-4xl lg:text-5xl">
						LINEA DE <span class="text-gtm-gold-ink">CONGELADOS</span>
					</h2>
					<p class="mt-4 text-base leading-relaxed text-slate-700 lg:text-lg">
						De la mano de Coldfood, desarrollamos soluciones en productos congelados para distribuidores, 
						importadores y marcas privadas, llevando la calidad del campo colombiano a mercados internacionales.
					</p>
					<a
						href="#contacto"
						class="mt-6 inline-block rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gtm-navy"
					>
						Solicitar cotización
					</a>
				</div>

				<div class="lg:col-span-7">
					<div class="aspect-[2/1] overflow-hidden rounded-2xl ring-1 ring-gtm-navy/10">
						<Image
							src={cadenaFrio}
							alt="Cadena de frío Coldfood y GTM Alliance: del cultivo colombiano a la planta certificada y el contenedor de exportación"
							widths={[560, 900, 1300, 1536]}
							sizes="(min-width: 1024px) 570px, 100vw"
							loading="lazy"
							class="h-full w-full object-cover"
						/>
					</div>
				</div>
			</div>

			<div class="border-t border-gtm-navy/10 px-6 py-10 sm:px-8 sm:py-12 lg:px-10">
				<!-- Timeline vertical: mobile / tablet -->
				<div class="grid grid-cols-[auto_1fr] gap-x-4 lg:hidden">
					{
						pasos.map((paso, i) => (
							<>
								<div class="flex flex-col items-center">
									<span
										set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">${paso.icon}</svg>`}
										class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white text-gtm-gold-ink ring-2 ring-gtm-navy/15"
									/>
									{i < pasos.length - 1 && <span class="mt-1 w-px flex-1 bg-gtm-navy/15" aria-hidden="true" />}
								</div>
								<div class={i < pasos.length - 1 ? 'congelados-paso pb-8' : 'congelados-paso'}>
									<span class="font-display block text-xs font-semibold tracking-widest text-gtm-gold-ink">
										{paso.num}
									</span>
									<h3 class="font-display mt-1 text-base font-bold text-gtm-navy">{paso.titulo}</h3>
									<p class="mt-1 text-sm leading-relaxed text-slate-600">{paso.descripcion}</p>
								</div>
							</>
						))
					}
				</div>

				<!-- Stepper horizontal: desktop -->
				<div class="relative hidden lg:grid lg:grid-cols-4 lg:gap-x-6">
					<div class="pointer-events-none absolute inset-x-[12.5%] top-7 h-px bg-gtm-navy/15" aria-hidden="true"></div>
					{
						pasos.map((paso) => (
							<div class="congelados-paso relative flex flex-col items-center text-center">
								<span
									set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">${paso.icon}</svg>`}
									class="relative z-10 flex h-14 w-14 items-center justify-center rounded-full bg-white text-gtm-gold-ink ring-2 ring-gtm-navy/15"
								/>
								<span class="font-display mt-3 text-xs font-semibold tracking-widest text-gtm-gold-ink">
									{paso.num}
								</span>
								<h3 class="font-display mt-1 text-sm font-bold text-gtm-navy">{paso.titulo}</h3>
								<p class="mt-1.5 max-w-[13rem] text-sm leading-relaxed text-slate-600">{paso.descripcion}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<div class="mt-14 sm:mt-20">
			<div class="congelados-portafolio">
				<span class="font-display text-xs font-semibold tracking-widest text-gtm-navy uppercase">
					Nuestro portafolio
				</span>
				<h3 class="font-display mt-2 text-2xl font-bold text-gtm-navy sm:text-3xl">Nuestras líneas de productos</h3>
			</div>

			<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					lineas.map((linea) => (
						<div class="congelados-producto overflow-hidden rounded-3xl bg-gtm-ice ring-1 ring-gtm-navy/10">
							<div class="aspect-[16/9] overflow-hidden p-3 sm:p-4">
								<Image
									src={linea.image}
									alt={linea.alt}
									widths={[360, 540, 700, 1000]}
									sizes="(min-width: 1024px) 348px, (min-width: 640px) calc(50vw - 3rem), calc(100vw - 2rem)"
									loading="lazy"
									class="h-full w-full object-contain"
								/>
							</div>
							<div class="p-5 sm:p-6">
								<h4 class="font-display text-xs font-semibold tracking-widest text-gtm-navy uppercase">
									Línea {linea.label}
								</h4>
								<p class="mt-2 text-sm leading-relaxed text-slate-700">{linea.descriptor}</p>
								<div class="mt-4 flex flex-wrap gap-2">
									{
										linea.productos.map((producto) => (
											<span class="rounded-full border border-gtm-navy/15 px-3 py-1 text-xs text-slate-700">
												{producto}
											</span>
										))
									}
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>

	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#congelados');

	if (section) {
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo('.congelados-hero', { y: 24, scale: 0.97 }, { y: 0, scale: 1, duration: 0.7 })
				.fromTo('.congelados-paso', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.4, stagger: 0.1 }, '-=0.3')
				.fromTo('.congelados-portafolio', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5 }, '-=0.2')
				.fromTo('.congelados-producto', { y: 24, scale: 0.97 }, { y: 0, scale: 1, duration: 0.5, stagger: 0.08 }, '-=0.2')
				.fromTo('.congelados-cta', { y: 28, scale: 0.98 }, { y: 0, scale: 1, duration: 0.6 }, '-=0.2');

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(
				['.congelados-hero', '.congelados-paso', '.congelados-portafolio', '.congelados-producto', '.congelados-cta'],
				{
					opacity: 1,
					y: 0,
					scale: 1,
				},
			);
		});
	}
</script>
