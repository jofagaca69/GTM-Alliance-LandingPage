---
import { Image } from 'astro:assets';
import coldfoodLogo from '../assets/logos/coldfood.png';
import cadenaFrio from '../assets/congelados/cadena-frio.png';
import lineaFrescos from '../assets/congelados/linea-frescos.png';
import lineaPrecocidos from '../assets/congelados/linea-precocidos.png';
import lineaCongelados from '../assets/congelados/linea-congelados.png';

const pasos = [
	{ num: '01', titulo: 'Origen', descripcion: 'Agricultores colombianos.' },
	{ num: '02', titulo: 'Producción', descripcion: 'Procesamiento especializado en planta Coldfood.' },
	{ num: '03', titulo: 'Tu marca', descripcion: 'Desarrollamos tu marca con la mejor presentación.' },
	{ num: '04', titulo: 'Exportación', descripcion: 'Consolidamos y exportamos a cualquier mercado del mundo.' },
];

const lineas = [
	{
		label: 'Frescos',
		descriptor: 'Naturales y nutritivos, listos para congelar con toda su frescura.',
		image: lineaFrescos,
		alt: 'Productos frescos de la línea GTM Alliance: yuca, plátano verde, lulo y mora empacados con marca propia',
		productos: ['Yuca Fresca', 'Plátano Verde', 'Lulo', 'Mora'],
	},
	{
		label: 'Precocidos',
		descriptor: 'Prácticos, deliciosos y listos para preparar.',
		image: lineaPrecocidos,
		alt: 'Productos precocidos de la línea GTM Alliance: croquetas y francesa de yuca, tajadas, plátanos maduros y tostones empacados con marca propia',
		productos: ['Yuca Croqueta', 'Tajadas', 'Plátanos Maduros', 'Tostones'],
	},
	{
		label: 'Congelados',
		descriptor: 'Variedad y calidad para cada necesidad del mercado.',
		image: lineaCongelados,
		alt: 'Productos congelados de la línea GTM Alliance: papa criolla, yuca stick, arracacha y mixes de vegetales empacados con marca propia',
		productos: ['Papa Criolla', 'Arracacha', 'Mix de Sancocho', 'Mix de Ajiaco'],
	},
];

const marcaChips = ['Diseño de marca', 'Identidad visual', 'Empaques y etiquetas', 'Normativa país destino'];

const ICONS = {
	calidad: '<circle cx="12" cy="8.5" r="5.25"/><path d="M9.25 8.5l1.85 1.85L14.75 6.5"/><path d="M9 13.25L7.25 19.5 12 17l4.75 2.5-1.75-6.25"/>',
	inocuidad: '<path d="M12 3s5.5 6.4 5.5 10.25a5.5 5.5 0 11-11 0C6.5 9.4 12 3 12 3z"/><path d="M9.25 13.25l1.85 1.85 3.65-4"/>',
	cadenaFrio:
		'<path d="M12 2.5v19M4.5 7l15 10M4.5 17L19.5 7"/><path d="M12 6.25l-1.75 1.05M12 6.25l1.75 1.05M12 17.75l-1.75-1.05M12 17.75l1.75-1.05M7.1 9.3l.3-2.05M7.1 9.3l-1.9.8M16.9 9.3l-.3-2.05M16.9 9.3l1.9.8M7.1 14.7l.3 2.05M7.1 14.7l-1.9-.8M16.9 14.7l-.3 2.05M16.9 14.7l1.9-.8"/>',
	alcance: '<path d="M12 21s7-7.6 7-12.75A7 7 0 105 8.25C5 13.4 12 21 12 21z"/><circle cx="12" cy="8.25" r="2.5"/>',
};

const sellos = [
	{ label: 'Calidad internacional', icon: ICONS.calidad },
	{ label: 'Inocuidad garantizada', icon: ICONS.inocuidad },
	{ label: 'Cadena de frío controlada', icon: ICONS.cadenaFrio },
	{ label: 'Llegamos más lejos por ti', icon: ICONS.alcance },
];
---

<section id="congelados" class="bg-transparent py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<!-- Bloque 1: qué es — hero + cadena de valor fusionados en una sola tarjeta -->
		<div class="congelados-hero overflow-hidden rounded-3xl bg-gtm-surface ring-1 ring-gtm-navy/10">
			<div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:items-center lg:gap-10 lg:p-10">
				<div class="lg:col-span-5">
					<div class="flex items-center gap-3">
						<Image
							src={coldfoodLogo}
							alt="Coldfood"
							height={36}
							densities={[1, 2]}
							loading="lazy"
							class="h-8 w-auto object-contain"
						/>
						<span class="text-xs font-medium text-slate-500">En alianza con Coldfood</span>
					</div>
					<h2 class="font-display mt-4 text-3xl leading-tight font-bold text-gtm-navy sm:text-4xl lg:text-5xl">
						Línea de <span class="text-gtm-gold-ink">Congelados</span>
					</h2>
					<p class="mt-4 text-base leading-relaxed text-slate-700 lg:text-lg">
						De la mano de Coldfood, llevamos lo mejor del campo colombiano a los mercados del mundo con
						tu propia marca.
					</p>
					<a
						href="#contacto"
						class="mt-6 inline-block rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gtm-navy"
					>
						Solicitar cotización
					</a>
				</div>

				<div class="lg:col-span-7">
					<div class="aspect-[2/1] overflow-hidden rounded-2xl ring-1 ring-gtm-navy/10">
						<Image
							src={cadenaFrio}
							alt="Cadena de frío Coldfood y GTM Alliance: del cultivo colombiano a la planta certificada y el contenedor de exportación"
							widths={[560, 900, 1300, 1536]}
							sizes="(min-width: 1024px) 570px, 100vw"
							loading="lazy"
							class="h-full w-full object-cover"
						/>
					</div>
				</div>
			</div>

			<!-- Cadena de valor: riel dividido de 4 pasos, al pie de la misma tarjeta -->
			<div class="grid grid-cols-1 divide-y divide-gtm-navy/10 border-t border-gtm-navy/10 sm:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-y-0">
				{
					pasos.map((paso) => (
						<div class="p-5 sm:p-6">
							<span class="font-display block text-3xl font-bold text-gtm-navy">{paso.num}</span>
							<h3 class="font-display mt-3 text-sm font-bold tracking-wide text-gtm-navy uppercase">
								{paso.titulo}
							</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-600">{paso.descripcion}</p>
						</div>
					))
				}
			</div>
		</div>

		<!-- Bloque 2: qué vendemos — las 3 líneas de producto, siempre visibles -->
		<div class="mt-14 sm:mt-20">
			<div class="congelados-portafolio">
				<span class="font-display text-xs font-semibold tracking-widest text-gtm-navy uppercase">
					Nuestro portafolio
				</span>
				<h3 class="font-display mt-2 text-2xl font-bold text-gtm-navy sm:text-3xl">Nuestras líneas de productos</h3>
			</div>

			<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					lineas.map((linea) => (
						<div class="congelados-producto overflow-hidden rounded-3xl bg-gtm-ice ring-1 ring-gtm-navy/10">
							<div class="aspect-[4/3] overflow-hidden">
								<Image
									src={linea.image}
									alt={linea.alt}
									widths={[360, 540, 700, 1000]}
									sizes="(min-width: 1024px) 348px, (min-width: 640px) calc(50vw - 3rem), calc(100vw - 2rem)"
									loading="lazy"
									class="h-full w-full object-cover"
								/>
							</div>
							<div class="p-5 sm:p-6">
								<h4 class="font-display text-xs font-semibold tracking-widest text-gtm-navy uppercase">
									Línea {linea.label}
								</h4>
								<p class="mt-2 text-sm leading-relaxed text-slate-700">{linea.descriptor}</p>
								<div class="mt-4 flex flex-wrap gap-2">
									{
										linea.productos.map((producto) => (
											<span class="rounded-full border border-gtm-navy/15 px-3 py-1 text-xs text-slate-700">
												{producto}
											</span>
										))
									}
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>

	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#congelados');

	if (section) {
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			// .congelados-hero, .congelados-producto y .congelados-cta son superficies
			// opacas sobre una sección bg-transparent con el globo (#globe-layer) fijo
			// detrás de toda la página: se animan con y/scale y nunca con opacity,
			// porque un panel semitransparente se mezcla con el globo animado y se ve
			// como manchas doradas/azules superpuestas (mismo criterio que Services.astro).
			tl.fromTo('.congelados-hero', { y: 24, scale: 0.97 }, { y: 0, scale: 1, duration: 0.7 })
				.fromTo('.congelados-portafolio', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5 }, '-=0.3')
				.fromTo('.congelados-producto', { y: 24, scale: 0.97 }, { y: 0, scale: 1, duration: 0.5, stagger: 0.08 }, '-=0.2')
				.fromTo('.congelados-cta', { y: 28, scale: 0.98 }, { y: 0, scale: 1, duration: 0.6 }, '-=0.2');

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(['.congelados-hero', '.congelados-portafolio', '.congelados-producto', '.congelados-cta'], {
				opacity: 1,
				y: 0,
				scale: 1,
			});
		});
	}
</script>
