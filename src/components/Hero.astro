---
---

<section id="inicio" class="relative flex min-h-dvh items-center">
	<!-- Scrim de legibilidad: fundido completo en móvil (texto sobre el globo),
	     izquierda-a-derecha en desktop (el globo respira en la columna derecha) -->
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-b from-gtm-deep/85 via-gtm-deep/55 to-gtm-deep lg:bg-gradient-to-r lg:from-gtm-deep lg:via-gtm-deep/80 lg:to-transparent"
	>
	</div>

	<div
		class="relative mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-12 px-4 py-32 sm:px-6 sm:py-40 lg:grid-cols-2 lg:gap-8 lg:px-8"
	>
		<div class="text-center lg:text-left">
			<span
				class="hero-eyebrow font-display inline-block rounded-full border border-white/15 bg-white/10 px-4 py-1 text-xs font-semibold tracking-widest text-gtm-gold uppercase backdrop-blur"
			>
				Logística Internacional
			</span>
			<h1
				class="hero-title font-display mt-6 text-4xl leading-tight font-bold text-white sm:text-5xl lg:text-6xl"
			>
				Conectamos tu carga <span class="text-gtm-gold">con el mundo</span>
			</h1>
			<p class="hero-subtitle mt-6 max-w-2xl text-base text-slate-300 sm:text-lg lg:mx-0 mx-auto">
				En GTM Alliance movemos tu carga seca y general por mar, tierra y aire con soluciones
				logísticas confiables, seguras y a tiempo.
			</p>
			<div
				class="hero-cta mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start"
			>
				<a
					href="#contacto"
					class="rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105"
				>
					Solicita una cotización
				</a>
				<a
					href="#servicios"
					class="rounded-full border border-white/40 px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
				>
					Conoce nuestros servicios
				</a>
			</div>
		</div>

		<!-- Columna reservada para el globo de fondo, que es fixed y vive detrás -->
		<div class="hidden lg:block" aria-hidden="true"></div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const mm = gsap.matchMedia();

	mm.add('(prefers-reduced-motion: no-preference)', () => {
		const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

		tl.fromTo('.hero-eyebrow', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 })
			.fromTo('.hero-title', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.8 }, '-=0.4')
			.fromTo(
				'.hero-subtitle',
				{ opacity: 0, y: 20 },
				{ opacity: 1, y: 0, duration: 0.7 },
				'-=0.5',
			)
			.fromTo('.hero-cta', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.5');

		return () => tl.kill();
	});

	mm.add('(prefers-reduced-motion: reduce)', () => {
		gsap.set(['.hero-eyebrow', '.hero-title', '.hero-subtitle', '.hero-cta'], {
			opacity: 1,
			scale: 1,
			y: 0,
		});
	});
</script>
