---

<section id="inicio" class="relative flex min-h-dvh items-center">
	<div
		class="relative mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-12 px-4 py-32 sm:px-6 sm:py-40 lg:grid-cols-2 lg:gap-8 lg:px-8"
	>
		<div class="text-center lg:text-left">
			<!--<p-->
			<!--	class="hero-eyebrow font-display inline-block rounded-3xl border border-gtm-navy/15 bg-white/60 px-4 py-1 text-sm font-semibold tracking-widest text-gtm-gold-ink uppercase backdrop-blur"-->
			<!--&gt;-->
			<!--	Soluciones Integrales en Comercio Exterior y Logística Internacional-->
			<!--</p>-->
			<h1
				class="hero-title font-display mt-6 text-4xl leading-tight font-bold text-gtm-navy sm:text-5xl lg:text-6xl"
			>
				Conectamos tu carga colombiana <span class="text-gtm-gold-ink">con el mundo</span>
			</h1>
			<p class="hero-subtitle mt-6 max-w-2xl text-base text-slate-700 sm:text-lg lg:mx-0 mx-auto">
				Ayudamos a productores, industrias y empresas a expandirse hacia mercados internacionales mediante soluciones de comercio exterior, exportación, logística internacional, cadena de frío y carga seca, garantizando trazabilidad y cumplimiento en cada operación.
			</p>
			<div
				class="hero-cta mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start"
			>
				<a
					href="#contacto"
					class="rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105"
				>
					Solicitar Asesoría
				</a>
				<a
					href="#servicios"
					class="rounded-full border border-gtm-navy/30 px-8 py-3 text-sm font-semibold text-gtm-navy transition-colors hover:bg-gtm-navy/5"
				>
					Explorar Soluciones
				</a>
			</div>
		</div>

		<!-- Columna reservada para el globo de fondo, que es fixed y vive detrás -->
		<div class="hidden lg:block" aria-hidden="true"></div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const mm = gsap.matchMedia();

	mm.add('(prefers-reduced-motion: no-preference)', () => {
		const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

		tl.fromTo('.hero-eyebrow', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 })
			.fromTo('.hero-title', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.8 }, '-=0.4')
			.fromTo(
				'.hero-subtitle',
				{ opacity: 0, y: 20 },
				{ opacity: 1, y: 0, duration: 0.7 },
				'-=0.5',
			)
			.fromTo('.hero-cta', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.5');

		return () => tl.kill();
	});

	mm.add('(prefers-reduced-motion: reduce)', () => {
		gsap.set(['.hero-eyebrow', '.hero-title', '.hero-subtitle', '.hero-cta'], {
			opacity: 1,
			scale: 1,
			y: 0,
		});
	});
</script>
