---
import { Image } from 'astro:assets';
import { NAV_ITEMS, groupTargets } from '../data/nav';
import logo from '../assets/logo.webp';

// Estado activo inicial (antes de que el scrollspy tome el control), para
// que el HTML servido ya llegue correcto y no haya flash en la primera
// pintura. Fuera de `/` no hay secciones que espiar en el home.
const initialActive = Astro.url.pathname === '/' ? 'inicio' : '';
---

<header class="fixed inset-x-4 top-4 z-50 sm:inset-x-6 md:inset-x-0">
	<div
		class="mx-auto flex max-w-4xl items-center justify-between gap-4 rounded-full border border-white/10 bg-gtm-navy/70 px-4 py-2.5 shadow-lg shadow-black/40 backdrop-blur-md md:px-6"
	>
		<a href="/#inicio" class="flex shrink-0 items-center rounded-full bg-white px-2.5 py-1">
			<Image
				src={logo}
				alt="GTM Alliance - Global Team Work"
				width={128}
				class="h-7 w-auto sm:h-8"
			/>
		</a>

		<nav class="hidden items-center gap-6 md:flex" aria-label="Principal">
			{
				NAV_ITEMS.map((item) => {
					if (item.kind === 'link') {
						return (
							<a
								href={item.href}
								data-nav-link={item.id}
								data-active={item.id === initialActive ? '' : undefined}
								aria-current={item.id === initialActive ? 'page' : undefined}
								class="border-b-2 border-transparent pb-0.5 text-sm font-medium text-slate-300 transition-colors hover:text-white data-[active]:border-gtm-gold data-[active]:text-white"
							>
								{item.label}
							</a>
						);
					}

					return (
						<div class="relative">
							<button
								type="button"
								id="dropdown-btn"
								data-nav-group={groupTargets(item)}
								aria-expanded="false"
								aria-haspopup="true"
								class="flex items-center gap-1 border-b-2 border-transparent pb-0.5 text-sm font-medium text-slate-300 transition-colors hover:text-white data-[active]:border-gtm-gold data-[active]:text-white"
							>
								{item.label}
								<svg
									id="dropdown-chevron"
									xmlns="http://www.w3.org/2000/svg"
									class="h-3.5 w-3.5 transition-transform duration-200"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2.5"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
								</svg>
							</button>

							<div
								id="dropdown-panel"
								role="menu"
								class="absolute left-1/2 mt-3 hidden w-[26rem] -translate-x-1/2 rounded-2xl border border-white/10 bg-gtm-navy/95 p-1 shadow-lg shadow-black/50 backdrop-blur-md"
							>
								<div class="grid grid-cols-2">
									{item.children.map((sub, i) => (
										<a
											href={sub.href}
											data-nav-link={sub.id}
											role="menuitem"
											class={`flex flex-col gap-1.5 rounded-xl p-4 ring-1 ring-transparent transition-colors hover:bg-white/5 data-[active]:bg-white/5 data-[active]:ring-gtm-gold/30 ${i === 0 ? 'border-r border-white/10' : ''}`}
										>
											<span class="font-display text-[10px] font-semibold tracking-widest text-gtm-gold uppercase">
												{sub.tag}
											</span>
											<span class="text-sm font-semibold text-white">{sub.label}</span>
											<span class="text-xs leading-relaxed text-slate-400">{sub.description}</span>
										</a>
									))}
								</div>
							</div>
						</div>
					);
				})
			}
		</nav>

		<button
			type="button"
			id="nav-toggle"
			class="flex h-9 w-9 items-center justify-center rounded-full text-white md:hidden"
			aria-expanded="false"
			aria-controls="nav-panel"
			aria-label="Abrir menú"
		>
			<svg
				id="icon-open"
				xmlns="http://www.w3.org/2000/svg"
				class="h-6 w-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="2"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg
				id="icon-close"
				xmlns="http://www.w3.org/2000/svg"
				class="hidden h-6 w-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="2"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
	</div>

	<!-- Mobile panel -->
	<nav
		id="nav-panel"
		aria-label="Principal (móvil)"
		class="mx-auto mt-2 hidden max-w-4xl flex-col gap-1 rounded-3xl border border-white/10 bg-gtm-navy/90 p-3 shadow-lg shadow-black/40 backdrop-blur-md md:hidden"
	>
		{
			NAV_ITEMS.map((item) =>
				item.kind === 'link' ? (
					<a
						href={item.href}
						data-nav-link={item.id}
						data-active={item.id === initialActive ? '' : undefined}
						aria-current={item.id === initialActive ? 'page' : undefined}
						class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white data-[active]:bg-white/10 data-[active]:text-white"
					>
						{item.label}
					</a>
				) : (
					<Fragment>
						<span class="font-display mt-1 px-4 text-[10px] font-semibold tracking-widest text-gtm-gold uppercase">
							{item.label}
						</span>
						{item.children.map((sub) => (
							<a
								href={sub.href}
								data-nav-link={sub.id}
								class="rounded-full py-2 pr-4 pl-7 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white data-[active]:bg-white/10 data-[active]:text-white"
							>
								{sub.label}
							</a>
						))}
					</Fragment>
				),
			)
		}
	</nav>
</header>

<script>
	// Mobile menu toggle
	const toggle = document.getElementById('nav-toggle');
	const panel = document.getElementById('nav-panel');
	const iconOpen = document.getElementById('icon-open');
	const iconClose = document.getElementById('icon-close');

	function setMobileOpen(open: boolean) {
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		panel?.classList.toggle('hidden', !open);
		panel?.classList.toggle('flex', open);
		iconOpen?.classList.toggle('hidden', open);
		iconClose?.classList.toggle('hidden', !open);
	}

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		setMobileOpen(!isOpen);
	});

	panel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMobileOpen(false));
	});

	// Desktop dropdown
	const dropdownBtn = document.getElementById('dropdown-btn');
	const dropdownPanel = document.getElementById('dropdown-panel');
	const dropdownChevron = document.getElementById('dropdown-chevron');

	function setDropdownOpen(open: boolean) {
		dropdownBtn?.setAttribute('aria-expanded', String(open));
		dropdownPanel?.classList.toggle('hidden', !open);
		dropdownChevron?.classList.toggle('rotate-180', open);
	}

	dropdownBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = dropdownBtn.getAttribute('aria-expanded') === 'true';
		setDropdownOpen(!isOpen);
	});

	dropdownPanel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setDropdownOpen(false));
	});

	document.addEventListener('click', (e) => {
		if (!dropdownBtn?.contains(e.target as Node) && !dropdownPanel?.contains(e.target as Node)) {
			setDropdownOpen(false);
		}
	});
</script>

<script>
	import { initScrollSpy } from '../scripts/scrollspy';

	initScrollSpy();
</script>
