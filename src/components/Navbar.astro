---
type SimpleLink = { label: string; href: string; active?: boolean };
type DropdownLink = {
	label: string;
	dropdown: { tag: string; title: string; href: string; description: string }[];
};
type NavItem = SimpleLink | DropdownLink;

const navItems: NavItem[] = [
	{ label: 'Inicio', href: '#inicio', active: true },
	{ label: 'Quiénes Somos', href: '#quienes-somos' },
	{
		label: 'Líneas de Negocio',
		dropdown: [
			{
				tag: 'Línea de Frío',
				title: 'Congelados',
				href: '#congelados',
				description: 'Cadena de frío con trazabilidad total, en alianza con Coldfood.',
			},
			{
				tag: 'Línea Seca',
				title: 'Carga Seca',
				href: '#carga-seca',
				description: 'Exportación multi-industria. Próximamente Medellín.',
			},
		],
	},
	{ label: 'Servicios', href: '#servicios' },
	{ label: 'Contacto', href: '#contacto' },
];
---

<header class="fixed inset-x-4 top-4 z-50 sm:inset-x-6 md:inset-x-0">
	<div
		class="mx-auto flex max-w-4xl items-center justify-between gap-4 rounded-full border border-white/60 bg-white/90 px-4 py-2.5 shadow-lg shadow-slate-900/5 backdrop-blur md:px-6"
	>
		<a href="#inicio" class="flex shrink-0 items-center gap-2">
			<img src="/logo.svg" alt="GTM Alliance" class="h-8 w-auto" />
			<span class="text-lg font-semibold tracking-tight text-gtm-navy">
				GTM <span class="font-normal">ALLIANCE</span>
			</span>
		</a>

		<nav class="hidden items-center gap-6 md:flex" aria-label="Principal">
			{
				navItems.map((item) => {
					if ('href' in item) {
						return (
							<a
								href={item.href}
								aria-current={item.active ? 'page' : undefined}
								class={`pb-0.5 text-sm font-medium transition-colors ${
									item.active
										? 'border-b-2 border-gtm-gold text-gtm-navy'
										: 'border-b-2 border-transparent text-slate-600 hover:text-gtm-navy'
								}`}
							>
								{item.label}
							</a>
						);
					}

					return (
						<div class="relative">
							<button
								type="button"
								id="dropdown-btn"
								aria-expanded="false"
								aria-haspopup="true"
								class="flex items-center gap-1 border-b-2 border-transparent pb-0.5 text-sm font-medium text-slate-600 transition-colors hover:text-gtm-navy"
							>
								{item.label}
								<svg
									id="dropdown-chevron"
									xmlns="http://www.w3.org/2000/svg"
									class="h-3.5 w-3.5 transition-transform duration-200"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2.5"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
								</svg>
							</button>

							<div
								id="dropdown-panel"
								role="menu"
								class="absolute left-1/2 mt-3 hidden w-[26rem] -translate-x-1/2 rounded-2xl border border-slate-200 bg-white p-1 shadow-lg shadow-slate-900/10"
							>
								<div class="grid grid-cols-2">
									{item.dropdown.map((sub, i) => (
										<a
											href={sub.href}
											role="menuitem"
											class={`flex flex-col gap-1.5 rounded-xl p-4 transition-colors hover:bg-slate-50 ${i === 0 ? 'border-r border-slate-100' : ''}`}
										>
											<span class="text-[10px] font-semibold tracking-widest text-gtm-gold uppercase">
												{sub.tag}
											</span>
											<span class="text-sm font-semibold text-gtm-navy">{sub.title}</span>
											<span class="text-xs leading-relaxed text-slate-500">{sub.description}</span>
										</a>
									))}
								</div>
							</div>
						</div>
					);
				})
			}
		</nav>

		<button
			type="button"
			id="nav-toggle"
			class="flex h-9 w-9 items-center justify-center rounded-full text-gtm-navy md:hidden"
			aria-expanded="false"
			aria-controls="nav-panel"
			aria-label="Abrir menú"
		>
			<svg
				id="icon-open"
				xmlns="http://www.w3.org/2000/svg"
				class="h-6 w-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="2"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg
				id="icon-close"
				xmlns="http://www.w3.org/2000/svg"
				class="hidden h-6 w-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="2"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
	</div>

	<!-- Mobile panel -->
	<nav
		id="nav-panel"
		aria-label="Principal (móvil)"
		class="mx-auto mt-2 hidden max-w-4xl flex-col gap-1 rounded-3xl border border-white/60 bg-white/95 p-3 shadow-lg shadow-slate-900/5 backdrop-blur md:hidden"
	>
		<a
			href="#inicio"
			aria-current="page"
			class="rounded-full bg-gtm-navy/5 px-4 py-2 text-sm font-medium text-gtm-navy transition-colors"
		>
			Inicio
		</a>
		<a
			href="#quienes-somos"
			class="rounded-full px-4 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-gtm-navy/5 hover:text-gtm-navy"
		>
			Quiénes Somos
		</a>

		<!-- Líneas de Negocio (expanded inline) -->
		<span class="mt-1 px-4 text-[10px] font-semibold tracking-widest text-gtm-gold uppercase">
			Líneas de Negocio
		</span>
		<a
			href="#congelados"
			class="rounded-full py-2 pl-7 pr-4 text-sm font-medium text-slate-600 transition-colors hover:bg-gtm-navy/5 hover:text-gtm-navy"
		>
			Congelados
		</a>
		<a
			href="#carga-seca"
			class="rounded-full py-2 pl-7 pr-4 text-sm font-medium text-slate-600 transition-colors hover:bg-gtm-navy/5 hover:text-gtm-navy"
		>
			Carga Seca
		</a>

		<a
			href="#servicios"
			class="mt-1 rounded-full px-4 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-gtm-navy/5 hover:text-gtm-navy"
		>
			Servicios
		</a>
		<a
			href="#contacto"
			class="rounded-full px-4 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-gtm-navy/5 hover:text-gtm-navy"
		>
			Contacto
		</a>
	</nav>
</header>

<script>
	// Mobile menu toggle
	const toggle = document.getElementById('nav-toggle');
	const panel = document.getElementById('nav-panel');
	const iconOpen = document.getElementById('icon-open');
	const iconClose = document.getElementById('icon-close');

	function setMobileOpen(open: boolean) {
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		panel?.classList.toggle('hidden', !open);
		panel?.classList.toggle('flex', open);
		iconOpen?.classList.toggle('hidden', open);
		iconClose?.classList.toggle('hidden', !open);
	}

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		setMobileOpen(!isOpen);
	});

	panel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMobileOpen(false));
	});

	// Desktop dropdown
	const dropdownBtn = document.getElementById('dropdown-btn');
	const dropdownPanel = document.getElementById('dropdown-panel');
	const dropdownChevron = document.getElementById('dropdown-chevron');

	function setDropdownOpen(open: boolean) {
		dropdownBtn?.setAttribute('aria-expanded', String(open));
		dropdownPanel?.classList.toggle('hidden', !open);
		dropdownChevron?.classList.toggle('rotate-180', open);
	}

	dropdownBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = dropdownBtn.getAttribute('aria-expanded') === 'true';
		setDropdownOpen(!isOpen);
	});

	dropdownPanel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setDropdownOpen(false));
	});

	document.addEventListener('click', (e) => {
		if (!dropdownBtn?.contains(e.target as Node) && !dropdownPanel?.contains(e.target as Node)) {
			setDropdownOpen(false);
		}
	});
</script>
