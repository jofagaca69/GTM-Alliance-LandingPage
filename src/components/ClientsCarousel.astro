---
import { Image } from 'astro:assets';
import coldfood from '../assets/logos/coldfood.png';
import cls from '../assets/logos/cls-logistic-solutions.png';
import logicx from '../assets/logos/logicx.png';

// Aliados estratégicos de GTM Alliance.
const aliados = [
	{
		src: coldfood,
		alt: 'Coldfood — aliado de GTM Alliance en procesamiento y exportación de alimentos congelados',
	},
	{
		src: cls,
		alt: 'CLS Logistic Solutions SAS — aliado de GTM Alliance en soluciones logísticas',
	},
	{
		src: logicx,
		alt: 'logicx, Agencia de Aduanas Nivel 2 — aliado de GTM Alliance en agenciamiento aduanero',
	},
];

// El track se duplica en el DOM (más abajo) para que el loop GSAP
// (xPercent: -50) empalme sin salto; aquí repetimos la lista de aliados
// para que cada mitad del track supere el ancho del contenedor (max-w-4xl).
const mitad = [...aliados, ...aliados];
---

<section id="clientes" class="bg-transparent py-24 sm:py-32">
	<div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
		<span
			class="font-display inline-block text-xs font-semibold tracking-widest text-gtm-gold uppercase"
		>
			Nuestros aliados
		</span>
		<h2 class="font-display mt-3 text-2xl font-bold text-white sm:text-3xl">
			Alianzas estratégicas
		</h2>

		<div
			class="marquee group relative mt-10 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]"
		>
			<div class="marquee-track flex w-max items-center gap-8 sm:gap-10">
				{
					mitad.map((item) => (
						<span class="flex shrink-0 items-center rounded-2xl bg-white/90 p-4">
							<Image
								src={item.src}
								alt={item.alt}
								height={64}
								densities={[1, 2]}
								loading="lazy"
								class="h-12 w-auto max-w-[10rem] object-contain opacity-80 transition duration-300 hover:opacity-100 sm:h-16"
							/>
						</span>
					))
				}
				{
					mitad.map((item) => (
						<span class="flex shrink-0 items-center rounded-2xl bg-white/90 p-4" aria-hidden="true">
							<Image
								src={item.src}
								alt=""
								height={64}
								densities={[1, 2]}
								loading="lazy"
								class="h-12 w-auto max-w-[10rem] object-contain opacity-80 transition duration-300 hover:opacity-100 sm:h-16"
							/>
						</span>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('.marquee');
	const track = document.querySelector<HTMLElement>('.marquee-track');

	if (section && track) {
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tween = gsap.to(track, {
				xPercent: -50,
				duration: 25,
				ease: 'none',
				repeat: -1,
			});

			const pause = () => tween.pause();
			const resume = () => tween.resume();

			section.addEventListener('mouseenter', pause);
			section.addEventListener('mouseleave', resume);

			return () => {
				tween.kill();
				section.removeEventListener('mouseenter', pause);
				section.removeEventListener('mouseleave', resume);
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(track, { xPercent: 0 });
		});
	}
</script>
