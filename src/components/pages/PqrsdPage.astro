---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_FORM_CONFIG } from '../../data/contact-form';
import { getLocale, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLocale(Astro.url);
const t = useTranslations(lang);

const siteBase = Astro.site ?? new URL('https://gtm-alliance.com');
const pageURL = new URL(localizePath('/pqrsd/', lang), siteBase).href;
const homeURL = new URL(localizePath('/', lang), siteBase).href;

const pqrsdSchema = [
	{
		'@type': 'ContactPage',
		'@id': `${pageURL}#webpage`,
		url: pageURL,
		name: t.schema.pqrsdPageName,
		description: t.seo.pqrsd.description,
		inLanguage: lang === 'es' ? 'es-CO' : 'en-US',
		isPartOf: { '@id': `${siteBase.href}#website` },
		about: { '@id': `${siteBase.href}#organization` },
		breadcrumb: { '@id': `${pageURL}#breadcrumb` },
	},
	{
		'@type': 'BreadcrumbList',
		'@id': `${pageURL}#breadcrumb`,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: t.schema.breadcrumbInicio, item: homeURL },
			{ '@type': 'ListItem', position: 2, name: 'PQRSD' },
		],
	},
];
---

<BaseLayout title={t.seo.pqrsd.title} description={t.seo.pqrsd.description} schema={pqrsdSchema}>
	<section id="pqrsd" class="relative overflow-hidden py-20 sm:py-28">
		<div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl">
				<span class="font-display inline-block text-xs font-semibold tracking-[0.35em] text-gtm-gold-ink uppercase">
					{t.pqrsd.eyebrow}
				</span>
				<h1 class="font-display mt-4 text-4xl leading-tight font-bold text-gtm-navy sm:text-5xl lg:text-6xl">
					{t.pqrsd.title}
				</h1>
				<p class="mt-5 text-lg leading-relaxed text-slate-700">
					{t.pqrsd.intro}
				</p>
			</div>

			<div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
				<div class="rounded-3xl border border-gtm-navy/10 bg-gtm-surface p-8 shadow-2xl shadow-gtm-navy/10 backdrop-blur-sm">
					<h2 class="font-display text-2xl font-semibold text-gtm-navy">{t.pqrsd.reportarTitle}</h2>
					<ul class="mt-6 space-y-4 text-sm leading-relaxed text-slate-700">
						{
							t.pqrsd.reportarItems.map((item) => (
								<li class="flex gap-3">
									<span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-gtm-gold" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>

					<div class="mt-8 rounded-2xl border border-gtm-gold/30 bg-gtm-gold/10 p-5">
						<p class="text-sm font-semibold text-gtm-gold-ink">{t.pqrsd.respuestaTitle}</p>
						<p class="mt-2 text-sm leading-relaxed text-slate-700">
							{t.pqrsd.respuestaBody}
						</p>
					</div>
				</div>

				<div class="rounded-3xl border border-gtm-navy/10 bg-gtm-surface p-8 shadow-2xl shadow-gtm-navy/10 backdrop-blur-sm">
					<h2 class="font-display text-2xl font-semibold text-gtm-navy">{t.pqrsd.formTitle}</h2>
					<form id="pqrsd-form" class="mt-6 grid gap-5 sm:grid-cols-2" action="https://api.web3forms.com/submit" method="POST">
						<input type="hidden" name="access_key" value={CONTACT_FORM_CONFIG.accessKey} />
						<input type="hidden" name="subject" value={CONTACT_FORM_CONFIG.pqrsd.subject} />
						<input type="hidden" name="from_name" value={CONTACT_FORM_CONFIG.fromName} />
						<input type="hidden" name="idioma" value={lang} />
						<input type="hidden" id="numero-radicado" name="numero_radicado" value="" />
						<input
							type="checkbox"
							name="botcheck"
							class="hidden"
							style="display: none;"
							tabindex="-1"
							autocomplete="off"
						/>

						<div class="sm:col-span-2">
							<label for="nombre" class="mb-2 block text-sm font-medium text-slate-700">{t.pqrsd.form.nombreLabel}</label>
							<input
								id="nombre"
								name="name"
								type="text"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
								placeholder={t.pqrsd.form.nombrePlaceholder}
							/>
						</div>

						<div>
							<label for="email" class="mb-2 block text-sm font-medium text-slate-700">{t.pqrsd.form.emailLabel}</label>
							<input
								id="email"
								name="email"
								type="email"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
								placeholder={t.pqrsd.form.emailPlaceholder}
							/>
						</div>

						<div>
							<label for="telefono" class="mb-2 block text-sm font-medium text-slate-700">{t.pqrsd.form.telefonoLabel}</label>
							<input
								id="telefono"
								name="telefono"
								type="tel"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
								placeholder={t.pqrsd.form.telefonoPlaceholder}
							/>
						</div>

						<div class="sm:col-span-2">
							<label for="tipo" class="mb-2 block text-sm font-medium text-slate-700">{t.pqrsd.form.tipoLabel}</label>
							<select
								id="tipo"
								name="tipo"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
							>
								<option value="" disabled selected>{t.pqrsd.form.tipoPlaceholder}</option>
								<option value="peticion">{t.pqrsd.form.tipoOpciones.peticion}</option>
								<option value="queja">{t.pqrsd.form.tipoOpciones.queja}</option>
								<option value="reclamo">{t.pqrsd.form.tipoOpciones.reclamo}</option>
								<option value="sugerencia">{t.pqrsd.form.tipoOpciones.sugerencia}</option>
								<option value="solicitud-informacion">{t.pqrsd.form.tipoOpciones.solicitudInformacion}</option>
								<option value="incidencia-operativa">{t.pqrsd.form.tipoOpciones.incidenciaOperativa}</option>
								<option value="otro">{t.pqrsd.form.tipoOpciones.otro}</option>
							</select>
						</div>

						<div class="sm:col-span-2">
							<label for="mensaje" class="mb-2 block text-sm font-medium text-slate-700">{t.pqrsd.form.mensajeLabel}</label>
							<textarea
								id="mensaje"
								name="message"
								rows="4"
								required
								class="w-full rounded-2xl border border-gtm-navy/15 bg-gtm-surface px-4 py-3 text-base text-gtm-navy placeholder:text-slate-500 focus:border-gtm-gold focus:outline-none focus:ring-2 focus:ring-gtm-gold/40"
								placeholder={t.pqrsd.form.mensajePlaceholder}
							></textarea>
						</div>

						<div class="sm:col-span-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
							<button
								id="pqrsd-submit"
								type="submit"
								class="inline-flex items-center justify-center rounded-full bg-gtm-gold px-7 py-3 text-sm font-semibold text-gtm-navy transition-transform hover:scale-[1.02] disabled:cursor-not-allowed disabled:opacity-60"
							>
								{t.pqrsd.form.submit}
							</button>
							<p
								id="pqrsd-form-status"
								class="text-sm text-slate-500"
								role="status"
								aria-live="polite"
								data-status-default={t.pqrsd.form.statusDefault}
								data-status-success={t.pqrsd.form.statusSuccess}
								data-status-error-prefix={t.pqrsd.form.statusErrorPrefix}
								data-status-error-fallback={t.pqrsd.form.statusErrorFallback}
								data-status-error-unexpected={t.pqrsd.form.statusErrorUnexpected}
								data-status-missing-key={t.pqrsd.form.statusMissingKey}
								data-sending-label={t.pqrsd.form.sending}
								data-submit-label={t.pqrsd.form.submit}
							>
								{t.pqrsd.form.statusDefault}
							</p>
						</div>

						<div
							id="pqrsd-success"
							class="hidden sm:col-span-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4"
							role="status"
							aria-live="polite"
						>
							<p class="text-sm font-semibold text-emerald-900">{t.pqrsd.form.successTitle}</p>
							<p class="mt-2 text-sm leading-relaxed text-emerald-800">
								{t.pqrsd.form.successBody}
							</p>
							<p id="pqrsd-radicado-display" class="font-display mt-2 text-lg font-bold tracking-wide text-gtm-navy" />
						</div>
					</form>
				</div>
			</div>
		</div>
	</section>

	<div id="privacy-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-gtm-navy/40 px-4 backdrop-blur-sm">
		<div class="w-full max-w-lg rounded-3xl border border-gtm-navy/10 bg-gtm-surface p-8 shadow-2xl shadow-gtm-navy/15">
			<h3 class="font-display text-2xl font-semibold text-gtm-navy">{t.pqrsd.privacyModal.title}</h3>
			<p class="mt-4 text-sm leading-relaxed text-slate-700">
				{t.pqrsd.privacyModal.body}
			</p>
			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
				<button id="cancel-policy" type="button" class="rounded-full border border-gtm-navy/20 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-gtm-navy/5">
					{t.pqrsd.privacyModal.cancel}
				</button>
				<button id="accept-policy" type="button" class="rounded-full bg-gtm-gold px-5 py-2.5 text-sm font-semibold text-gtm-navy transition-transform hover:scale-[1.02]">
					{t.pqrsd.privacyModal.accept}
				</button>
			</div>
		</div>
	</div>

	<style>
		select#tipo option {
			background-color: #ffffff;
			color: #1c2f4a;
		}

		select#tipo option[disabled] {
			color: #64748b;
		}
	</style>

	<script>
		import { CONTACT_FORM_CONFIG, generateNumeroRadicado } from '../../data/contact-form';

		const form = document.getElementById('pqrsd-form') as HTMLFormElement | null;
		const modal = document.getElementById('privacy-modal');
		const cancelButton = document.getElementById('cancel-policy');
		const acceptButton = document.getElementById('accept-policy');
		const submitButton = document.getElementById('pqrsd-submit') as HTMLButtonElement | null;
		const statusEl = document.getElementById('pqrsd-form-status');
		const successEl = document.getElementById('pqrsd-success');
		const radicadoInput = document.getElementById('numero-radicado') as HTMLInputElement | null;
		const radicadoDisplay = document.getElementById('pqrsd-radicado-display');
		const accessKey = CONTACT_FORM_CONFIG.accessKey.trim();

		// Textos localizados, pasados desde el frontmatter vía `data-*` en
		// `#pqrsd-form-status` (un `<script>` de navegador no puede resolver
		// `Astro.currentLocale`).
		const i18nText = {
			default: statusEl?.dataset.statusDefault ?? '',
			success: statusEl?.dataset.statusSuccess ?? '',
			errorPrefix: statusEl?.dataset.statusErrorPrefix ?? '',
			errorFallback: statusEl?.dataset.statusErrorFallback ?? '',
			errorUnexpected: statusEl?.dataset.statusErrorUnexpected ?? '',
			missingKey: statusEl?.dataset.statusMissingKey ?? '',
			sendingLabel: statusEl?.dataset.sendingLabel ?? '',
			submitLabel: statusEl?.dataset.submitLabel ?? '',
		};

		function setStatus(message: string, tone: 'default' | 'error' | 'success') {
			if (!statusEl) return;

			statusEl.textContent = message;
			statusEl.classList.remove('text-red-600', 'text-emerald-700', 'text-slate-500');

			if (tone === 'error') {
				statusEl.classList.add('text-red-600');
			} else if (tone === 'success') {
				statusEl.classList.add('text-emerald-700');
			} else {
				statusEl.classList.add('text-slate-500');
			}
		}

		function hideSuccess() {
			successEl?.classList.add('hidden');
			if (radicadoDisplay) radicadoDisplay.textContent = '';
			if (radicadoInput) radicadoInput.value = '';
		}

		function showSuccess(radicado: string) {
			if (radicadoDisplay) radicadoDisplay.textContent = radicado;
			successEl?.classList.remove('hidden');
		}

		async function submitForm(formElement: HTMLFormElement) {
			if (submitButton) {
				submitButton.disabled = true;
				submitButton.textContent = i18nText.sendingLabel;
			}

			hideSuccess();
			setStatus(i18nText.sendingLabel, 'default');

			const radicado = generateNumeroRadicado();
			if (radicadoInput) radicadoInput.value = radicado;

			try {
				const formData = new FormData(formElement);
				const payload = Object.fromEntries(formData.entries());

				payload.subject = `${CONTACT_FORM_CONFIG.pqrsd.subject} [${radicado}]`;

				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						Accept: 'application/json',
					},
					body: JSON.stringify(payload),
				});

				const result = await response.json().catch(() => ({
					success: false,
					message: i18nText.errorUnexpected,
				}));

				if (response.ok && result.success) {
					formElement.reset();
					if (radicadoInput) radicadoInput.value = radicado;
					showSuccess(radicado);
					setStatus(i18nText.success, 'success');
				} else {
					throw new Error(result.message ?? i18nText.errorFallback);
				}
			} catch (error) {
				const message = error instanceof Error ? error.message : i18nText.errorFallback;
				console.error('Web3Forms PQRSD submit failed', error);
				setStatus(`${i18nText.errorPrefix} ${message}`, 'error');
			} finally {
				if (submitButton) {
					submitButton.disabled = false;
					submitButton.textContent = i18nText.submitLabel;
				}
			}
		}

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			modal?.classList.remove('hidden');
			modal?.classList.add('flex');
		});

		cancelButton?.addEventListener('click', () => {
			modal?.classList.add('hidden');
			modal?.classList.remove('flex');
		});

		acceptButton?.addEventListener('click', async () => {
			modal?.classList.add('hidden');
			modal?.classList.remove('flex');

			if (!form) return;

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			if (!accessKey) {
				setStatus(i18nText.missingKey, 'error');
				return;
			}

			await submitForm(form);
		});

		form?.addEventListener('input', () => {
			hideSuccess();
			setStatus(i18nText.default, 'default');
		});
	</script>
</BaseLayout>
