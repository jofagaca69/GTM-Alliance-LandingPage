---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import cargaSeca from '../assets/carga-seca.jpg';
import multimarca from '../assets/multimarca.png';
import pcolombianos from '../assets/pcolombianos.png';
import { TELEFONO2, whatsappHref } from '../data/contact';
import { getLocale, useTranslations } from '../i18n/utils';

const lang = getLocale(Astro.url);
const t = useTranslations(lang);

const CATALOGO_PDF = '/docs/catalogo-carga-seca.pdf';

const logoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.{jpg,JPG}', {
	eager: true,
});

function logo(path: string) {
	const mod = logoModules[`../assets/logos/${path}`];
	if (!mod) throw new Error(`Logo no encontrado: ${path}`);
	return mod.default;
}

const pasos = t.dryCargo.pasos;

const marcas = [
	{ nombre: 'Colcafé', src: logo('colcafe.jpg') },
	{ nombre: 'Café La Bastilla', src: logo('cafe.jpg') },
	{ nombre: 'Chocolate Corona', src: logo('corona.jpg') },
	{ nombre: 'Chocolate', src: logo('chocolate.jpg') },
	{ nombre: 'Choco Listo', src: logo('choco.jpg') },
	{ nombre: 'Saltín Noel', src: logo('saltin.jpg') },
	{ nombre: 'Ducales', src: logo('ducales.jpg') },
	{ nombre: 'Universal', src: logo('universal.jpg') },
	{ nombre: 'Doria', src: logo('doria.jpg') },
	{ nombre: 'Deli', src: logo('deli.jpg') },
	{ nombre: 'Jet', src: logo('jet.jpg') },
	{ nombre: 'Jumbo', src: logo('jumbo.jpg') },
];

const pistaMarcas = [...marcas, ...marcas];

const heroSlides = [
	{ src: multimarca, alt: t.dryCargo.heroMultimarcaAlt },
	{ src: cargaSeca, alt: t.dryCargo.heroImgAlt },
	{ src: pcolombianos, alt: t.dryCargo.heroProductosAlt },
];
---

<section id="carga-seca" class="bg-transparent py-10 sm:py-10">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="carga-hero overflow-hidden rounded-3xl bg-gtm-surface ring-1 ring-gtm-navy/10">
			<div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:items-center lg:gap-10 lg:p-10">
				<div class="lg:col-span-5">
					<h2 class="carga-title font-display text-3xl leading-tight font-bold text-gtm-navy sm:text-4xl lg:text-5xl">
						{t.dryCargo.titleLead} <span class="text-gtm-gold-ink">{t.dryCargo.titleHighlight}</span>
					</h2>
					<p class="carga-intro mt-4 text-base leading-relaxed text-slate-700 lg:text-lg">
						{t.dryCargo.introLead} {t.dryCargo.introTrail}
					</p>
					<div class="mt-6 flex flex-wrap items-center gap-3">
						<a
							href={whatsappHref(TELEFONO2.numero, lang)}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-full bg-gtm-gold px-8 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gtm-navy"
						>
							{t.dryCargo.cta}
						</a>
						<a
							href={CATALOGO_PDF}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block shrink-0 rounded-full bg-gtm-gold px-6 py-3 text-sm font-semibold text-gtm-navy shadow-lg shadow-gtm-gold/30 transition-transform hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gtm-navy"
						>
							{t.dryCargo.portafolioVerMas}
						</a>
					</div>
				</div>

				<div class="lg:col-span-7">
					<div class="carga-slideshow relative aspect-[1063/650] overflow-hidden rounded-2xl bg-[#0a1220] ring-1 ring-gtm-navy/10">
						{
							heroSlides.map((slide, i) => (
								<Image
									src={slide.src}
									alt={slide.alt}
									widths={[560, 900, 1063]}
									sizes="(min-width: 1024px) 570px, 100vw"
									quality={90}
									loading="lazy"
									class:list={[
										'carga-slide absolute inset-0 h-full w-full object-contain object-center',
										i > 0 && 'opacity-0',
									]}
									aria-hidden={i > 0 ? 'true' : undefined}
								/>
							))
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Stepper: Así funciona GTM -->
		<div class="carga-stepper mt-12 sm:mt-16">
			<div class="flex items-center justify-between gap-4">
				<h3 class="font-display text-2xl font-bold text-gtm-navy sm:text-3xl">{t.dryCargo.stepperTitle}</h3>
				<div class="flex shrink-0 gap-2">
					<button
						type="button"
						class="carga-paso-prev flex h-9 w-9 items-center justify-center rounded-full border border-gtm-navy/15 bg-white text-gtm-navy transition-colors hover:bg-gtm-navy/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gtm-gold disabled:pointer-events-none disabled:opacity-30 sm:h-11 sm:w-11"
						aria-label={t.dryCargo.prevAriaLabel}
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
							<path d="M15 6l-6 6 6 6" />
						</svg>
					</button>
					<button
						type="button"
						class="carga-paso-next flex h-9 w-9 items-center justify-center rounded-full border border-gtm-navy/15 bg-white text-gtm-navy transition-colors hover:bg-gtm-navy/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gtm-gold disabled:pointer-events-none disabled:opacity-30 sm:h-11 sm:w-11"
						aria-label={t.dryCargo.nextAriaLabel}
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
							<path d="M9 6l6 6-6 6" />
						</svg>
					</button>
				</div>
			</div>

			<div class="relative mt-6 sm:mt-8">
				<ol
					class="carga-paso-track flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 pe-8 [scroll-padding-inline:1rem] overscroll-x-contain touch-pan-x sm:gap-5 lg:pe-0 lg:[mask-image:linear-gradient(to_right,transparent,black_2%,black_96%,transparent)]"
					tabindex="0"
					role="region"
					aria-label={t.dryCargo.trackAriaLabel}
				>
					{
						pasos.map((paso, i) => (
							<li class="carga-paso flex w-[calc(100%-3.25rem)] max-w-[17rem] shrink-0 snap-start flex-col gap-2 rounded-2xl border border-gtm-gold/40 bg-white p-4 shadow-sm shadow-gtm-navy/5 sm:w-[17rem] sm:gap-3 sm:p-5 lg:w-[16.5rem]">
								<span class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink">
									{String(i + 1).padStart(2, '0')}
								</span>
								<h4 class="font-display text-base font-bold leading-snug text-gtm-navy">{paso.titulo}</h4>
								<p class="text-sm leading-relaxed text-slate-600">{paso.descripcion}</p>
							</li>
						))
					}
				</ol>
				<div
					class="carga-paso-edge pointer-events-none absolute inset-y-0 right-0 flex w-10 items-center justify-end bg-gradient-to-l from-gtm-bone to-transparent transition-opacity duration-300 lg:hidden"
					aria-hidden="true"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="carga-paso-edge-icon mr-0.5 h-5 w-5 text-gtm-gold-ink">
						<path d="M9 6l6 6-6 6" />
					</svg>
				</div>
			</div>

			<div class="carga-paso-dots mt-4 flex items-center justify-center gap-1.5 lg:hidden" aria-hidden="true">
				{
					pasos.map((_, i) => (
						<span
							class:list={[
								'carga-paso-dot h-1.5 rounded-full transition-all duration-300',
								i === 0 ? 'w-4 bg-gtm-gold-ink' : 'w-1.5 bg-gtm-navy/20',
							]}
							data-paso-dot={i}
						></span>
					))
				}
			</div>
		</div>

		<!-- Carrusel de marcas -->
		<div class="carga-marcas mt-12 sm:mt-16">
			<h3 class="font-display text-xl font-bold leading-tight text-gtm-navy sm:text-2xl">
				{t.dryCargo.marcasTitle}
			</h3>

			<div
				class="carga-marquee group relative mt-6 min-w-0 overflow-hidden sm:mt-8 [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
			>
				<div class="carga-marquee-track flex w-max items-center">
					{
						pistaMarcas.map((marca, i) => {
							const decorativo = i >= marcas.length;
							return (
								<span
									class="mr-3 flex h-14 shrink-0 items-center justify-center rounded-xl bg-white px-4 ring-1 ring-gtm-navy/10 sm:mr-6 sm:h-24 sm:rounded-2xl sm:px-8"
									aria-hidden={decorativo ? 'true' : undefined}
								>
									<Image
										src={marca.src}
										alt={decorativo ? '' : marca.nombre}
										height={56}
										densities={[1, 2]}
										loading="lazy"
										class="h-8 w-auto max-w-[7rem] object-contain opacity-90 sm:h-12 sm:max-w-[9rem]"
									/>
								</span>
							);
						})
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#carga-seca');

	if (section) {
		const mm = gsap.matchMedia();
		const marquee = section.querySelector('.carga-marquee');
		const track = section.querySelector<HTMLElement>('.carga-marquee-track');
		const pasoTrack = section.querySelector<HTMLElement>('.carga-paso-track');
		const pasoPrev = section.querySelector<HTMLButtonElement>('.carga-paso-prev');
		const pasoNext = section.querySelector<HTMLButtonElement>('.carga-paso-next');
		const pasoEdge = section.querySelector<HTMLElement>('.carga-paso-edge');
		const pasoDots = section.querySelectorAll<HTMLElement>('[data-paso-dot]');
		const slides = gsap.utils.toArray<HTMLElement>('.carga-slide', section);
		const slideshow = section.querySelector('.carga-slideshow');
		const firstSlide = slides[0];

		const pasoStep = () => {
			if (!pasoTrack) return 260;
			const card = pasoTrack.querySelector<HTMLElement>('.carga-paso');
			const gap = Number.parseFloat(getComputedStyle(pasoTrack).columnGap || getComputedStyle(pasoTrack).gap) || 16;
			return (card?.offsetWidth ?? 240) + gap;
		};

		const scrollPasos = (direction: 1 | -1) => {
			if (!pasoTrack) return;
			pasoTrack.scrollBy({ left: direction * pasoStep(), behavior: 'smooth' });
		};
		const goPrev = () => scrollPasos(-1);
		const goNext = () => scrollPasos(1);

		const updatePasoUi = () => {
			if (!pasoTrack) return;
			const step = pasoStep();
			const index = Math.min(pasoDots.length - 1, Math.max(0, Math.round(pasoTrack.scrollLeft / step)));
			const max = pasoTrack.scrollWidth - pasoTrack.clientWidth - 8;
			const atStart = pasoTrack.scrollLeft <= 8;
			const atEnd = pasoTrack.scrollLeft >= max;

			pasoPrev?.toggleAttribute('disabled', atStart);
			pasoNext?.toggleAttribute('disabled', atEnd);
			pasoEdge?.classList.toggle('opacity-0', !atStart);

			pasoDots.forEach((dot, i) => {
				const active = i === index;
				dot.classList.toggle('w-4', active);
				dot.classList.toggle('bg-gtm-gold-ink', active);
				dot.classList.toggle('w-1.5', !active);
				dot.classList.toggle('bg-gtm-navy/20', !active);
			});
		};

		pasoPrev?.addEventListener('click', goPrev);
		pasoNext?.addEventListener('click', goNext);
		pasoTrack?.addEventListener('scroll', updatePasoUi, { passive: true });
		updatePasoUi();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo('.carga-hero', { y: 24, scale: 0.97 }, { y: 0, scale: 1, duration: 0.7 })
				.fromTo('.carga-stepper', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.35')
				.fromTo('.carga-paso', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.4, stagger: 0.08 }, '-=0.3')
				.fromTo('.carga-marcas', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.2');

			let hintTween: gsap.core.Timeline | undefined;
			const cancelHint = () => hintTween?.kill();

			if (pasoTrack && window.matchMedia('(max-width: 1023px)').matches) {
				hintTween = gsap.timeline({
					delay: 0.35,
					scrollTrigger: {
						trigger: pasoTrack,
						start: 'top 85%',
						once: true,
					},
					onUpdate: updatePasoUi,
				});
				hintTween
					.to(pasoTrack, { scrollLeft: 56, duration: 0.7, ease: 'power2.out' })
					.to(pasoTrack, { scrollLeft: 0, duration: 0.55, ease: 'power2.inOut' });
				pasoTrack.addEventListener('touchstart', cancelHint, { once: true, passive: true });
			}

			let marqueeTween: gsap.core.Tween | undefined;
			const pause = () => marqueeTween?.pause();
			const resume = () => marqueeTween?.resume();

			if (marquee && track) {
				marqueeTween = gsap.to(track, {
					xPercent: -50,
					duration: 25,
					ease: 'none',
					repeat: -1,
				});
				marquee.addEventListener('mouseenter', pause);
				marquee.addEventListener('mouseleave', resume);
			}

			const fade = 0.8;
			const hold = 4;
			let slideTl: gsap.core.Timeline | undefined;
			let onVisibility: (() => void) | undefined;

			if (slides.length > 1 && firstSlide) {
				gsap.set(slides, { autoAlpha: 0 });
				gsap.set(firstSlide, { autoAlpha: 1 });

				const markActive = (index: number) => {
					slides.forEach((slide, i) => {
						slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
					});
				};

				const slideLoop = gsap.timeline({
					repeat: -1,
					defaults: { duration: fade, ease: 'power2.inOut' },
					scrollTrigger: slideshow
						? {
								trigger: slideshow,
								start: 'top bottom',
								end: 'bottom top',
								toggleActions: 'play pause play pause',
							}
						: undefined,
				});
				slideTl = slideLoop;

				slides.forEach((slide, i) => {
					const next = slides[(i + 1) % slides.length];
					if (!next) return;
					const at = i * (hold + fade) + hold;
					slideLoop.to(slide, { autoAlpha: 0 }, at);
					slideLoop.to(next, { autoAlpha: 1, onStart: () => markActive((i + 1) % slides.length) }, at);
				});

				onVisibility = () => {
					if (document.hidden) slideLoop.pause();
					else slideLoop.play();
				};
				document.addEventListener('visibilitychange', onVisibility);
			}

			return () => {
				if (onVisibility) document.removeEventListener('visibilitychange', onVisibility);
				hintTween?.kill();
				slideTl?.scrollTrigger?.kill();
				slideTl?.kill();
				tl.scrollTrigger?.kill();
				tl.kill();
				marqueeTween?.kill();
				marquee?.removeEventListener('mouseenter', pause);
				marquee?.removeEventListener('mouseleave', resume);
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(
				['.carga-hero', '.carga-stepper', '.carga-paso', '.carga-marcas'],
				{ opacity: 1, y: 0, scale: 1 },
			);
			if (track) gsap.set(track, { xPercent: 0 });
			if (firstSlide) {
				gsap.set(firstSlide, { autoAlpha: 1 });
				gsap.set(slides.slice(1), { autoAlpha: 0 });
			}
		});
	}
</script>

<style>
	.carga-paso-track {
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}

	.carga-paso-track::-webkit-scrollbar {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.carga-paso-track {
			scroll-behavior: smooth;
		}

		.carga-paso-edge:not(.opacity-0) .carga-paso-edge-icon {
			animation: carga-paso-nudge 1.6s ease-in-out infinite;
		}
	}

	@keyframes carga-paso-nudge {
		0%,
		100% {
			transform: translateX(0);
			opacity: 1;
		}
		50% {
			transform: translateX(4px);
			opacity: 0.45;
		}
	}
</style>
