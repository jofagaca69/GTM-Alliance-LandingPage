---
import ComingSoonCover from './ComingSoonCover.astro';

const aliados = [
	{
		nombre: 'Alimentec',
		producto: 'Productos alimenticios secos y procesados',
	},
	{
		nombre: 'Bocadillos',
		producto: 'Producción y exportación de dulces típicos',
	},
	{
		nombre: 'Universal',
		producto: 'Consumo masivo y alimentos secos',
	},
	{
		nombre: 'Aluminios Medellín',
		producto: 'Láminas, perfiles y productos industriales',
	},
	{
		nombre: 'Barriles Ahumadores',
		producto: 'Barriles metálicos para cocción y ahumado',
	},
];

const servicios = [
	'Almacenaje especializado',
	'Picking, empaque y despacho',
	'Control de inventarios en tiempo real',
	'Procesamiento a la medida',
	'Coordinación logística y aduanera',
];
---

<section id="carga-seca" class="bg-transparent py-16 sm:py-24">
	<ComingSoonCover
		etiqueta="Próximamente"
		titulo="Próximamente en Medellín"
		descripcion="Estamos preparando esta línea de operación. Muy pronto podrás exportar tu carga seca con nosotros desde Medellín."
		ctaLabel="Quiero saber más"
		ctaHref="mailto:info@gtmalliance.com?subject=Interés%20en%20la%20línea%20de%20carga%20seca%20—%20Medellín"
	>
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<span
				class="carga-eyebrow font-display inline-block text-xs font-semibold tracking-widest text-gtm-gold uppercase"
			>
				02 — Línea de carga seca
			</span>

			<h2
				class="carga-title font-display mt-3 max-w-3xl text-3xl leading-tight font-bold text-white sm:text-4xl lg:text-5xl"
			>
				Eficiencia y confianza para tu operación internacional
			</h2>

			<p class="carga-intro mt-4 max-w-3xl text-base leading-relaxed text-slate-300 lg:text-lg">
				Exportamos productos de múltiples industrias con almacenamiento, procesamiento y
				distribución bajo estándares internacionales.
			</p>

			<div class="mt-10 grid grid-cols-1 gap-8 sm:mt-16 lg:grid-cols-2">
				<div class="carga-table overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm">
					<div class="divide-y divide-white/10 sm:hidden">
						{
							aliados.map((aliado) => (
								<div class="p-5">
									<p class="font-display text-[11px] font-semibold tracking-widest text-slate-400 uppercase">
										Aliado / línea
									</p>
									<p class="mt-1 text-sm font-bold text-slate-100">{aliado.nombre}</p>
									<p class="font-display mt-3 text-[11px] font-semibold tracking-widest text-slate-400 uppercase">
										Productos
									</p>
									<p class="mt-1 text-sm leading-relaxed text-slate-300">{aliado.producto}</p>
								</div>
							))
						}
					</div>
					<div class="hidden overflow-x-auto sm:block">
						<table class="w-full min-w-[28rem] border-collapse text-left">
							<thead>
								<tr class="border-b border-white/10">
									<th
										class="font-display px-6 py-4 text-xs font-semibold tracking-widest text-slate-400 uppercase"
									>
										Aliado / línea
									</th>
									<th
										class="font-display px-6 py-4 text-xs font-semibold tracking-widest text-slate-400 uppercase"
									>
										Productos
									</th>
								</tr>
							</thead>
							<tbody>
								{
									aliados.map((aliado, i) => (
										<tr
											class:list={[
												'transition-colors duration-300 hover:bg-white/5',
												i !== aliados.length - 1 && 'border-b border-white/10',
											]}
										>
											<td class="px-6 py-4 align-top text-sm font-bold whitespace-nowrap text-slate-100">
												{aliado.nombre}
											</td>
											<td class="px-6 py-4 align-top text-sm leading-relaxed text-slate-300">
												{aliado.producto}
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>

				<div class="flex flex-col gap-6">
					<div class="carga-photo min-h-[16rem] overflow-hidden rounded-2xl">
						<img
							src="/images/linea-carga-seca.jpg"
							alt="Bodega de carga seca con estanterías y estibas — operación logística GTM Alliance"
							loading="lazy"
							class="h-full w-full object-cover"
						/>
					</div>

					<div class="carga-services rounded-2xl bg-gtm-navy/60 p-8 ring-1 ring-gtm-gold/25 backdrop-blur-sm">
						<span class="font-display text-xs font-semibold tracking-widest text-gtm-gold uppercase">
							Servicios de la línea
						</span>
						<ul class="mt-4 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
							{
								servicios.map((servicio) => (
									<li class="flex gap-3 text-sm leading-relaxed text-slate-200">
										<span class="text-gtm-gold" aria-hidden="true">
											→
										</span>
										<span>{servicio}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</ComingSoonCover>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#carga-seca');

	if (section) {
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo(
				'.carga-eyebrow',
				{ opacity: 0, y: 16 },
				{ opacity: 1, y: 0, duration: 0.5, stagger: 0.1 },
			)
				.fromTo('.carga-title', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.3')
				.fromTo(
					'.carga-intro',
					{ opacity: 0, y: 24 },
					{ opacity: 1, y: 0, duration: 0.7 },
					'-=0.5',
				)
				.fromTo(
					'.carga-table',
					{ opacity: 0, y: 32 },
					{ opacity: 1, y: 0, duration: 0.6 },
					'-=0.3',
				)
				.fromTo(
					'.carga-photo',
					{ opacity: 0, y: 32 },
					{ opacity: 1, y: 0, duration: 0.6 },
					'-=0.4',
				)
				.fromTo(
					'.carga-services',
					{ opacity: 0, y: 32 },
					{ opacity: 1, y: 0, duration: 0.6 },
					'-=0.3',
				);

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(['.carga-eyebrow', '.carga-title', '.carga-intro', '.carga-table', '.carga-photo', '.carga-services'], {
				opacity: 1,
				y: 0,
			});
		});
	}
</script>
