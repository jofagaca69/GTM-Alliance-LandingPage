---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import puerto from '../assets/puerto2.png';
import contenedor from '../assets/container2.png';

const logoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.{jpg,JPG}', {
	eager: true,
});
const iconModules = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.png', {
	eager: true,
});

function logo(path: string) {
	const mod = logoModules[`../assets/logos/${path}`];
	if (!mod) throw new Error(`Logo no encontrado: ${path}`);
	return mod.default;
}

function icon(path: string) {
	const mod = iconModules[`../assets/icons/${path}`];
	if (!mod) throw new Error(`Icono no encontrado: ${path}`);
	return mod.default;
}

const pasos = [
	{
		titulo: 'Compra a fabricantes aliados',
		descripcion: 'Negociamos directamente con múltiples fabricantes colombianos.',
		icon: icon('apreton-de-manos.png'),
	},
	{
		titulo: 'Recepción en nuestra bodega',
		descripcion: 'Recibimos y verificamos la mercancía en nuestras instalaciones especializadas.',
		icon: icon('garaje.png'),
	},
	{
		titulo: 'Etiquetado según país destino',
		descripcion: 'Adaptamos el etiquetado e información a las normativas de cada mercado.',
		icon: icon('etiqueta.png'),
	},
	{
		titulo: 'Embalaje especializado',
		descripcion: 'Usamos el empaque adecuado para proteger cada producto durante el transporte.',
		icon: icon('embalaje.png'),
	},
	{
		titulo: 'Consolidación de carga',
		descripcion: 'Agrupamos diferentes productos de varios proveedores en un solo envío.',
		icon: icon('logistica.png'),
	},
	{
		titulo: 'Gestión documental y aduanera',
		descripcion: 'Nos encargamos de toda la documentación, permisos e inspecciones.',
		icon: icon('documentos.png'),
	},
	{
		titulo: 'Exportación internacional',
		descripcion: 'Coordinamos el transporte internacional hasta el puerto de destino.',
		icon: icon('camion-de-reparto.png'),
	},
];

const marcas = [
	{ nombre: 'Colcafé', src: logo('colcafe.jpg') },
	{ nombre: 'Café La Bastilla', src: logo('cafe.jpg') },
	{ nombre: 'Chocolate Corona', src: logo('corona.jpg') },
	{ nombre: 'Chocolate', src: logo('chocolate.jpg') },
	{ nombre: 'Choco Listo', src: logo('choco.jpg') },
	{ nombre: 'Saltín Noel', src: logo('saltin.jpg') },
	{ nombre: 'Ducales', src: logo('ducales.jpg') },
	{ nombre: 'Universal', src: logo('universal.jpg') },
	{ nombre: 'Doria', src: logo('doria.jpg') },
	{ nombre: 'Deli', src: logo('deli.jpg') },
	{ nombre: 'Jet', src: logo('jet.jpg') },
	{ nombre: 'Jumbo', src: logo('jumbo.jpg') },
];

const pistaMarcas = [...marcas, ...marcas, ...marcas, ...marcas];

const beneficios = [
	{ label: 'Menor inversión en inventario', icon: icon('dinero.png') },
	{ label: 'Reducción de costos logísticos', icon: icon('precio-bajo.png') },
	{ label: 'Más productos, más oportunidades', icon: icon('agregar-producto.png') },
	{ label: 'Seguridad en cada etapa del proceso', icon: icon('privacidad-de-datos.png') },
	{ label: 'Acceso a nuevos mercados', icon: icon('acceso-a-internet.png') },
	{ label: 'Trazabilidad y control total', icon: icon('prueba.png') },
];
---

<section id="carga-seca" class="bg-transparent py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="carga-hero relative aspect-[21/9] overflow-hidden rounded-3xl sm:aspect-[3/1]">
			<Image
				src={puerto}
				alt="Puerto de consolidación de carga seca — GTM Alliance"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 1024px) 1152px, 100vw"
				loading="lazy"
				class="absolute inset-0 h-full w-full object-cover object-[center_42%]"
			/>
			<div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/55 via-black/20 to-transparent px-5 pt-10 pb-5 sm:px-8 sm:pb-6 lg:px-10">
				<h2 class="carga-title font-display max-w-2xl text-2xl leading-tight font-bold text-white drop-shadow-md sm:text-3xl lg:text-4xl">
					Línea de <span class="text-gtm-gold">carga seca</span>
				</h2>
				<p class="carga-intro mt-1.5 max-w-lg text-sm leading-relaxed text-slate-100 drop-shadow-md sm:text-base">
					Consolidamos productos de múltiples fabricantes en un solo embarque internacional.
				</p>
			</div>
		</div>

		<!-- Stepper: Así funciona GTM -->
		<div class="carga-stepper mt-16 sm:mt-20">
			<div class="text-center">
				<span class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
					Proceso
				</span>
				<h3 class="font-display mt-3 text-2xl font-bold text-gtm-navy sm:text-3xl">
					Así funciona GTM
				</h3>
			</div>

			<ol class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-7 lg:gap-3">
				{
					pasos.map((paso, i) => (
						<li class="relative">
							{i < pasos.length - 1 && (
								<span
									class="pointer-events-none absolute top-5 -right-2 z-10 hidden text-gtm-gold lg:block"
									aria-hidden="true"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
										<path d="M8.5 5.5l7 6.5-7 6.5V5.5z" />
									</svg>
								</span>
							)}
							<div class="flex h-full flex-col items-start rounded-2xl border border-gtm-gold/40 bg-white p-4 shadow-md shadow-gtm-navy/5 sm:p-3">
								<span class="font-display flex h-8 w-8 items-center justify-center rounded-full bg-gtm-gold text-xs font-bold text-gtm-navy">
									{i + 1}
								</span>
								<Image
									src={paso.icon}
									alt=""
									width={28}
									height={28}
									densities={[1, 2]}
									loading="lazy"
									class="mt-4 h-7 w-7 object-contain"
								/>
								<span class="font-display mt-3 text-xs font-bold leading-snug text-gtm-navy uppercase">
									{paso.titulo}
								</span>
								<span class="mt-2 text-[11px] leading-relaxed text-slate-600 sm:text-[11px]">{paso.descripcion}</span>
							</div>
						</li>
					))
				}
			</ol>
		</div>

		<!-- Carrusel de marcas -->
		<div class="carga-marcas mt-16 sm:mt-20">
			<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:gap-10">
				<div class="shrink-0 lg:max-w-[11rem]">
					<span class="font-display text-xs font-semibold tracking-widest text-gtm-gold-ink uppercase">
						Aliados
					</span>
					<h3 class="font-display mt-2 text-xl font-bold leading-tight text-gtm-navy sm:text-2xl">
						Marcas colombianas que consolidamos
					</h3>
				</div>

				<div
					class="carga-marquee group relative min-w-0 flex-1 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
				>
					<div class="carga-marquee-track flex w-max items-center">
						{
							pistaMarcas.map((marca, i) => {
								const decorativo = i >= marcas.length;
								return (
									<span
										class="mr-5 flex h-20 shrink-0 items-center justify-center rounded-2xl bg-white px-6 ring-1 ring-gtm-navy/10 sm:mr-6 sm:h-24 sm:px-8"
										aria-hidden={decorativo ? 'true' : undefined}
									>
										<Image
											src={marca.src}
											alt={decorativo ? '' : marca.nombre}
											height={56}
											densities={[1, 2]}
											loading="lazy"
											class="h-10 w-auto max-w-[9rem] object-contain opacity-90 sm:h-12"
										/>
									</span>
								);
							})
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Beneficios -->
		<div class="carga-beneficios mt-16 sm:mt-20">
			<div class="text-center">
				<h3 class="font-display text-2xl font-bold text-gtm-navy sm:text-3xl">
					¿Por qué consolidar con GTM?
				</h3>
			</div>
			<ul class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6 lg:gap-4">
				{
					beneficios.map((item) => (
						<li class="flex flex-col items-center gap-3 text-center">
							<span class="flex h-14 w-14 items-center justify-center rounded-full bg-gtm-navy/5 ring-1 ring-gtm-navy/10">
								<Image
									src={item.icon}
									alt=""
									width={40}
									height={40}
									densities={[1, 2]}
									loading="lazy"
									class="h-9 w-9 object-contain"
								/>
							</span>
							<span class="font-display text-[11px] font-semibold tracking-wide text-gtm-navy uppercase sm:text-xs">
								{item.label}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<!-- CTA -->
		<div
			class="carga-cta mt-16 grid overflow-hidden rounded-3xl bg-gtm-navy sm:mt-20 lg:grid-cols-[1.1fr_0.9fr]"
		>
			<div class="flex flex-col justify-center gap-5 p-8 sm:p-10 lg:p-12">
				<p class="font-display text-2xl font-bold leading-tight text-white sm:text-3xl">
					Consolidamos Colombia en un solo embarque.
				</p>
				<p class="text-sm leading-relaxed text-slate-300 sm:text-base">
					Tu carga, nuestra experiencia, el mundo como destino.
				</p>
			</div>
			<div class="relative min-h-40 overflow-hidden lg:min-h-0">
				<Image
					src={contenedor}
					alt="Contenedor de carga seca listo para exportación"
					widths={[400, 700, 1000]}
					sizes="(min-width: 1024px) 480px, 100vw"
					loading="lazy"
					class="absolute inset-0 h-full w-full scale-90 object-contain object-center"
				/>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#carga-seca');

	if (section) {
		const mm = gsap.matchMedia();
		const marquee = section.querySelector('.carga-marquee');
		const track = section.querySelector<HTMLElement>('.carga-marquee-track');

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo('.carga-hero', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.7 })
				.fromTo('.carga-title', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.35')
				.fromTo('.carga-intro', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.5')
				.fromTo('.carga-stepper', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.35')
				.fromTo('.carga-marcas', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.3')
				.fromTo('.carga-beneficios', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.25')
				.fromTo('.carga-cta', { opacity: 0, y: 28 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.2');

			let marqueeTween: gsap.core.Tween | undefined;
			const pause = () => marqueeTween?.pause();
			const resume = () => marqueeTween?.resume();

			if (marquee && track) {
				marqueeTween = gsap.to(track, {
					xPercent: -50,
					duration: 28,
					ease: 'none',
					repeat: -1,
				});
				marquee.addEventListener('mouseenter', pause);
				marquee.addEventListener('mouseleave', resume);
			}

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
				marqueeTween?.kill();
				marquee?.removeEventListener('mouseenter', pause);
				marquee?.removeEventListener('mouseleave', resume);
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(
				[
					'.carga-hero',
					'.carga-title',
					'.carga-intro',
					'.carga-stepper',
					'.carga-marcas',
					'.carga-beneficios',
					'.carga-cta',
				],
				{ opacity: 1, y: 0 },
			);
			if (track) gsap.set(track, { xPercent: 0 });
		});
	}
</script>
