---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import cargaSeca from '../assets/carga-seca.jpg';
import contenedor from '../assets/container2.png';

const logoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.{jpg,JPG}', {
	eager: true,
});
const iconModules = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.png', {
	eager: true,
});

function logo(path: string) {
	const mod = logoModules[`../assets/logos/${path}`];
	if (!mod) throw new Error(`Logo no encontrado: ${path}`);
	return mod.default;
}

function icon(path: string) {
	const mod = iconModules[`../assets/icons/${path}`];
	if (!mod) throw new Error(`Icono no encontrado: ${path}`);
	return mod.default;
}

const pasos = [
	{
		titulo: 'Compra a fabricantes aliados',
		descripcion: 'Negociamos directamente con múltiples fabricantes colombianos.',
		icon: icon('apreton-de-manos.png'),
	},
	{
		titulo: 'Recepción en nuestra bodega',
		descripcion: 'Recibimos y verificamos la mercancía en nuestras instalaciones especializadas.',
		icon: icon('garaje.png'),
	},
	{
		titulo: 'Etiquetado según país destino',
		descripcion: 'Adaptamos el etiquetado e información a las normativas de cada mercado.',
		icon: icon('etiqueta.png'),
	},
	{
		titulo: 'Embalaje especializado',
		descripcion: 'Usamos el empaque adecuado para proteger cada producto durante el transporte.',
		icon: icon('embalaje.png'),
	},
	{
		titulo: 'Consolidación de carga',
		descripcion: 'Agrupamos diferentes productos de varios proveedores en un solo envío.',
		icon: icon('logistica.png'),
	},
	{
		titulo: 'Gestión documental y aduanera',
		descripcion: 'Nos encargamos de toda la documentación, permisos e inspecciones.',
		icon: icon('documentos.png'),
	},
	{
		titulo: 'Exportación internacional',
		descripcion: 'Coordinamos el transporte internacional hasta el puerto de destino.',
		icon: icon('camion-de-reparto.png'),
	},
];

const marcas = [
	{ nombre: 'Colcafé', src: logo('colcafe.jpg') },
	{ nombre: 'Café La Bastilla', src: logo('cafe.jpg') },
	{ nombre: 'Chocolate Corona', src: logo('corona.jpg') },
	{ nombre: 'Chocolate', src: logo('chocolate.jpg') },
	{ nombre: 'Choco Listo', src: logo('choco.jpg') },
	{ nombre: 'Saltín Noel', src: logo('saltin.jpg') },
	{ nombre: 'Ducales', src: logo('ducales.jpg') },
	{ nombre: 'Universal', src: logo('universal.jpg') },
	{ nombre: 'Doria', src: logo('doria.jpg') },
	{ nombre: 'Deli', src: logo('deli.jpg') },
	{ nombre: 'Jet', src: logo('jet.jpg') },
	{ nombre: 'Jumbo', src: logo('jumbo.jpg') },
];

const pistaMarcas = [...marcas, ...marcas, ...marcas, ...marcas];

const beneficios = [
	{ label: 'Menor inversión en inventario', icon: icon('dinero.png') },
	{ label: 'Reducción de costos logísticos', icon: icon('precio-bajo.png') },
	{ label: 'Más productos, más oportunidades', icon: icon('agregar-producto.png') },
	{ label: 'Seguridad en cada etapa del proceso', icon: icon('privacidad-de-datos.png') },
	{ label: 'Acceso a nuevos mercados', icon: icon('acceso-a-internet.png') },
	{ label: 'Trazabilidad y control total', icon: icon('prueba.png') },
];
---

<section id="carga-seca" class="bg-transparent py-10 sm:py-16 lg:py-16">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="carga-hero relative aspect-[16/9] overflow-hidden rounded-2xl sm:aspect-[21/9] sm:rounded-3xl lg:aspect-[2.35/1]">
			<Image
				src={cargaSeca}
				alt="Línea de carga seca — consolidación y exportación GTM Alliance"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 1024px) 1152px, 100vw"
				loading="lazy"
				class="absolute inset-0 h-full w-full object-cover object-[center_55%] sm:object-[center_50%] lg:object-center"
			/>
			<div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-br from-black/70 via-black/25 to-transparent"></div>
			<div class="absolute left-0 top-0 z-20 max-w-md px-4 pt-4 pb-6 text-left sm:max-w-lg sm:px-8 sm:pt-6 lg:max-w-xl lg:px-10 lg:pt-8">
				<h2 class="carga-title font-display text-xl leading-tight font-bold text-white drop-shadow-md sm:text-3xl lg:text-4xl">
					<span class="block">LINEA DE</span>
					<span class="block text-gtm-gold">CARGA SECA</span>
				</h2>
				<p class="carga-intro mt-1.5 text-xs leading-relaxed text-slate-100 drop-shadow-md sm:mt-2 sm:text-sm lg:text-base">
					Consolidamos productos de múltiples 
					<span class="block">fabricantes en un solo embarque internacional.</span>
				</p>
				
			</div>
		</div>

		<!-- Stepper: Así funciona GTM -->
		<div class="carga-stepper mt-8 sm:mt-14 lg:mt-10">
			<div class="text-center">
				<h3 class="font-display mt-1.5 text-xl font-bold text-gtm-navy sm:mt-3 sm:text-3xl">
					Así funciona GTM
				</h3>
			</div>

			<ol class="mt-5 grid grid-cols-2 gap-2 sm:mt-8 sm:grid-cols-3 sm:gap-3 lg:mt-6 lg:grid-cols-7 lg:gap-2">
				{
					pasos.map((paso, i) => (
						<li class="relative">
							{i < pasos.length - 1 && (
								<span
									class="pointer-events-none absolute top-1/2 -right-1.5 z-10 hidden -translate-y-1/2 text-gtm-gold lg:block"
									aria-hidden="true"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
										<path d="M8.5 5.5l7 6.5-7 6.5V5.5z" />
									</svg>
								</span>
							)}
							<div class="flex aspect-square flex-col items-center justify-center gap-1 rounded-xl border border-gtm-gold/40 bg-white p-2 text-center shadow-sm shadow-gtm-navy/5 sm:gap-1.5 sm:rounded-2xl sm:p-3 sm:shadow-md lg:gap-1 lg:p-2">
								<span class="font-display flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gtm-gold text-[10px] font-bold text-gtm-navy sm:h-7 sm:w-7 sm:text-[11px]">
									{i + 1}
								</span>
								<Image
									src={paso.icon}
									alt=""
									width={28}
									height={28}
									densities={[1, 2]}
									loading="lazy"
									class="h-6 w-6 object-contain sm:h-7 sm:w-7"
								/>
								<span class="font-display line-clamp-3 text-[9px] font-bold leading-tight text-gtm-navy uppercase sm:text-[10px] lg:text-[9px]">
									{paso.titulo}
								</span>
								<span class="line-clamp-2 hidden text-[10px] leading-snug text-slate-600 sm:block lg:hidden">{paso.descripcion}</span>
							</div>
						</li>
					))
				}
			</ol>
		</div>

		<!-- Carrusel de marcas -->
		<div class="carga-marcas mt-8 sm:mt-14 lg:mt-10">
			<div class="flex flex-col gap-3 sm:gap-6 lg:flex-row lg:items-center lg:gap-6">
				<div class="shrink-0 lg:max-w-[11rem]">
					<h3 class="font-display mt-1 text-lg font-bold leading-tight text-gtm-navy sm:mt-2 sm:text-2xl">
						Marcas colombianas que consolidamos
					</h3>
				</div>

				<div
					class="carga-marquee group relative min-w-0 flex-1 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
				>
					<div class="carga-marquee-track flex w-max items-center">
						{
							pistaMarcas.map((marca, i) => {
								const decorativo = i >= marcas.length;
								return (
									<span
										class="mr-3 flex h-14 shrink-0 items-center justify-center rounded-xl bg-white px-4 ring-1 ring-gtm-navy/10 sm:mr-6 sm:h-24 sm:rounded-2xl sm:px-8"
										aria-hidden={decorativo ? 'true' : undefined}
									>
										<Image
											src={marca.src}
											alt={decorativo ? '' : marca.nombre}
											height={56}
											densities={[1, 2]}
											loading="lazy"
											class="h-8 w-auto max-w-[7rem] object-contain opacity-90 sm:h-12 sm:max-w-[9rem]"
										/>
									</span>
								);
							})
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Beneficios + CTA -->
		<div class="carga-beneficios-cta mt-8 sm:mt-14 lg:mt-10">
			<div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:gap-5">
				<div class="carga-beneficios min-w-0 flex-1">
					<h3 class="font-display text-center text-xl font-bold text-gtm-navy sm:text-2xl">
						¿Por qué consolidar con GTM?
					</h3>
					<ul class="mt-4 grid grid-cols-3 gap-3 sm:mt-5 sm:gap-5 lg:mt-4 lg:grid-cols-6 lg:gap-3">
						{
							beneficios.map((item) => (
								<li class="flex flex-col items-center gap-1.5 text-center sm:gap-2">
									<span class="flex h-9 w-9 items-center justify-center rounded-full bg-gtm-navy/5 ring-1 ring-gtm-navy/10 sm:h-12 sm:w-12">
										<Image
											src={item.icon}
											alt=""
											width={40}
											height={40}
											densities={[1, 2]}
											loading="lazy"
											class="h-5 w-5 object-contain sm:h-7 sm:w-7"
										/>
									</span>
									<span class="font-display text-[9px] font-semibold leading-tight tracking-wide text-gtm-navy uppercase sm:text-[10px]">
										{item.label}
									</span>
								</li>
							))
						}
					</ul>
				</div>

				<aside class="carga-cta flex w-full shrink-0 flex-row overflow-hidden bg-gtm-navy lg:w-80 xl:w-96">
					<div class="relative w-28 shrink-0 sm:w-32 lg:w-36">
						<Image
							src={contenedor}
							alt="Contenedor de carga seca listo para exportación"
							widths={[200, 320, 480]}
							sizes="144px"
							loading="lazy"
							class="h-full w-full object-contain object-left p-1"
						/>
					</div>
					<div class="flex min-w-0 flex-1 flex-col justify-center p-4 text-left sm:p-5">
						<p class="font-display text-sm font-bold leading-snug text-white sm:text-base">
							<span >CONSOLIDAMOS COLOMBIA</span> 
							<span class="text-gtm-gold"> EN UN SOLO EMBARQUE.</span> 
						</p>
						<p class="mt-1.5 text-[11px] leading-relaxed text-slate-300 sm:text-xs">
							Tu carga, nuestra experiencia, el mundo como destino.
						</p>
					</div>
				</aside>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from '../scripts/gsap';

	const section = document.querySelector('#carga-seca');

	if (section) {
		const mm = gsap.matchMedia();
		const marquee = section.querySelector('.carga-marquee');
		const track = section.querySelector<HTMLElement>('.carga-marquee-track');

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const tl = gsap.timeline({
				defaults: { ease: 'power3.out' },
				scrollTrigger: {
					trigger: section,
					start: 'top 75%',
				},
			});

			tl.fromTo('.carga-hero', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.7 })
				.fromTo('.carga-title', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.35')
				.fromTo('.carga-intro', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.5')
				.fromTo('.carga-stepper', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.35')
				.fromTo('.carga-marcas', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.3')
				.fromTo('.carga-beneficios-cta', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.25');

			let marqueeTween: gsap.core.Tween | undefined;
			const pause = () => marqueeTween?.pause();
			const resume = () => marqueeTween?.resume();

			if (marquee && track) {
				marqueeTween = gsap.to(track, {
					xPercent: -50,
					duration: 28,
					ease: 'none',
					repeat: -1,
				});
				marquee.addEventListener('mouseenter', pause);
				marquee.addEventListener('mouseleave', resume);
			}

			return () => {
				tl.scrollTrigger?.kill();
				tl.kill();
				marqueeTween?.kill();
				marquee?.removeEventListener('mouseenter', pause);
				marquee?.removeEventListener('mouseleave', resume);
			};
		});

		mm.add('(prefers-reduced-motion: reduce)', () => {
			gsap.set(
				[
					'.carga-hero',
					'.carga-title',
					'.carga-intro',
					'.carga-stepper',
					'.carga-marcas',
					'.carga-beneficios-cta',
				],
				{ opacity: 1, y: 0 },
			);
			if (track) gsap.set(track, { xPercent: 0 });
		});
	}
</script>
