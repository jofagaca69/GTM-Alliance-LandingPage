# Configuración para Hostinger (Apache / LiteSpeed). Se copia a dist/ en cada build.

# --- Redirección www -> dominio sin www (301) ---
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP_HOST} ^www\.gtm-alliance\.com$ [NC]
	RewriteRule ^(.*)$ https://gtm-alliance.com/$1 [R=301,L]
</IfModule>

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Caché ---
# /_astro/ y /fonts/ llevan hash o son estáticos: caché de 1 año.
<IfModule mod_headers.c>
	<FilesMatch "\.(woff2?|webp|avif|png|jpe?g|svg|ico|css|js)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(html|xml|txt|pdf|webmanifest)$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>
</IfModule>

# --- Página 404 ---
ErrorDocument 404 /404.html
